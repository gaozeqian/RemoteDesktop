<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1716 guards against VB keywords (Get, Set, Shared); this is a C#-only code base. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>RemoteDesktop</Company>
    <Product>Remote Desktop</Product>
    <!--
      The product version, and the only place one is written down. Every installer, bundle, package name and telemetry
      payload derives from it; the build scripts read this element rather than keeping a copy. Three numbers, because
      Windows Installer requires major.minor.build (the packaging scripts append the fourth .0), and because a
      pre-release suffix cannot be expressed in an MSI.
    -->
    <Version>1.0.0</Version>
    <!--
      The commit goes into a separate assembly attribute, not into AssemblyInformationalVersion. The file's
      "Product version" on Windows is the informational version, so leaving the hash there put it in a field meant
      for people (Explorer, the file properties dialog). Telemetry still gets "1.0.0+<sha>" - ProductVersion.Full
      joins the two - while the UI, the packages and the file metadata stay three-part.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Build output goes to the repository's single artifacts/ root, the same one the packaging scripts already write to
    (artifacts/app, artifacts/installer, artifacts/lib — see CONTRIBUTING.md). Without this, every project grows its
    own bin/ and obj/ next to its sources: 27 projects meant 54 directories to clean, to ignore and to explain, and a
    "where is the output" question with one answer per project.

    The layout this produces is the SDK's: artifacts/bin/<Project>/<pivot>/, artifacts/obj/<Project>/<pivot>/,
    artifacts/publish/<Project>/<pivot>/ and artifacts/package/<pivot>/. ArtifactsPath has to be set here rather than left to
    the default, which would resolve against each project's own directory and scatter artifacts/ folders through src/
    instead of collecting them.

    Not every project in the repository is affected: the WiX and installer projects under build/installer/ carry their
    own (deliberately empty) Directory.Build.props, so they do not import this file at all — see the note in
    build/installer/windows/client/Directory.Build.props.
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    The commit has to be added after source control information is initialized, which is why this is a target rather
    than an item in a static ItemGroup: $(SourceRevisionId) is empty at evaluation time. GenerateAssemblyInfo turns
    each AssemblyMetadata item into an AssemblyMetadataAttribute, which ProductVersion.Full reads back.
  -->
  <Target Name="RemoteDesktopAddCommitMetadata"
          BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="InitializeSourceControlInformation">
    <ItemGroup Condition="'$(SourceRevisionId)' != ''">
      <AssemblyMetadata Include="Commit" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>
</Project>
