# Nothing built belongs in a Docker build context: the images build from source inside the container.
**/bin/
**/obj/
**/artifacts/
.git/
# The installers build Windows packages out of the same sources; nothing in the container needs them.
build/installer/
build/signing/
# The compose files read build/docker/.env, which holds the database password, relay key and node token. None of the
# images needs it, and a remote builder must not receive it.
**/.env
**/.env.*
*.log
