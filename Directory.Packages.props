<Project>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Hosting / infrastructure -->
    <!-- Platform tests build a real container so that a port whose constructor throws cannot pass as registered, and
         a port that takes a logger needs a provider to build one. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <!-- The server hosts run under systemd on Linux; the same binary still runs from a console. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- The person's own settings file is layered into configuration; see UserSettings. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- The setup command restarts the installed service (ServiceController) -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <!-- Windows platform: DXGI capture, Media Foundation codecs -->
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="Vortice.MediaFoundation" Version="3.8.3" />
    <!-- Linux platform: the desktop portals are D-Bus services, and this is the only maintained managed D-Bus stack.
         Handing the portal's file descriptors around is why a package is needed at all: OpenPipeWireRemote and
         ConnectToEIS both return a descriptor (D-Bus type 'h'), and the command-line tools cannot carry one out.
         Still on 0.x upstream, so it is kept behind one file's worth of wrapper rather than used across the layer. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <!-- Linux platform: libavcodec bindings, generated from the FFmpeg headers of the version named here (8.0, i.e.
         libavcodec 62 — the same major version the project binds by soname, and what Ubuntu 26.04 ships). Generated
         rather than hand-written on purpose: AVCodecContext is a large struct that grows every release, and getting
         an offset wrong there corrupts memory rather than failing. The Windows side made the same call with Vortice
         instead of hand-writing Direct3D. It also means the library's major version is a hard requirement, which
         FfmpegLibraries checks for rather than discovering later. -->
    <PackageVersion Include="FFmpeg.AutoGen" Version="8.0.0" />
    <!-- File transfer integrity check -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.13" />
    <!-- Audio: WASAPI capture/playback and the Opus codec -->
    <PackageVersion Include="NAudio.Wasapi" Version="3.2.0" />
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <!-- Protocol -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <!-- A reviewed SRP-6a implementation; password authentication must not be hand-written crypto. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <!-- Database. Both drivers live in RemoteDesktop.Server.Storage: which one a deployment uses is a setting, so
         the host never references either of them, and adding a third is a package line in one project. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- The storage layer reads its own settings section and registers itself; it is a plain class library, so both
         abstractions are referenced rather than coming in with a framework reference. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <!-- Reads streams out of a built .msi. The tests use it for the custom action DLL inside the package: the
         automation API cannot hand back binary (it returns a string, which stops at the first zero byte), and the
         installer's own DLL starts with "MZ", 0x90, 0x00. Same version as the custom action project. -->
    <PackageVersion Include="WixToolset.Dtf.WindowsInstaller" Version="5.0.2" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- The TRX reporter is an MTP extension, not part of the platform: without it the test executables reject the
         TRX-report switch (exit code 5). CI's test summary is built from the TRX files, so every test project needs
         it. Its version tracks Microsoft.Testing.Platform, which xunit.v3 4.x brings in at the same 2.5.x. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
