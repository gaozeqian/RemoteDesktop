<Project>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Hosting / infrastructure -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- Platform tests build a real container so that a port whose constructor throws cannot pass as registered -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- The setup command restarts the installed service (ServiceController) -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <!-- Windows platform: DXGI capture, Media Foundation codecs -->
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="Vortice.MediaFoundation" Version="3.8.3" />
    <!-- File transfer integrity check -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <!-- Audio: WASAPI capture/playback and the Opus codec -->
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <!-- Protocol -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <!-- Database -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Installer: WiX v5 on purpose (v6+ requires OSMF for commercial use) -->
    <PackageVersion Include="WixToolset.Sdk" Version="5.0.2" />
    <!-- Reads streams out of a built .msi. The tests use it for the custom action DLL inside the package: the
         automation API cannot hand back binary (it returns a string, which stops at the first zero byte), and the
         installer's own DLL starts with "MZ", 0x90, 0x00. Same version as the custom action project. -->
    <PackageVersion Include="WixToolset.Dtf.WindowsInstaller" Version="5.0.2" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- The TRX reporter is an MTP extension, not part of the platform: without it the test executables reject the
         TRX-report switch (exit code 5). CI's test summary is built from the TRX files, so every test project needs
         it. Its version tracks Microsoft.Testing.Platform, which xunit.v3 4.x brings in at the same 2.5.x. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
