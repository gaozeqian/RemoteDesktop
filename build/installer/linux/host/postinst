#!/bin/sh
#
# Applies the answers from the installation questions (the signaling address, a certificate for wss://, and the
# optional unattended password), then turns the host on for everybody who logs in and says what is missing if
# anything is.
#
# The password goes into the secret store of the user the host runs as, so it is written as that user rather than as
# root, and before the service starts: the service reads the fixed password once, when it starts.
#
# The host itself belongs to the graphical session, and at the moment a package is configured there may be no session
# at all — no display, no session bus, nobody to answer the portal's dialog. WantedBy=graphical-session.target in the
# unit file is what starts it then; this script only starts it for users who are already signed in.
set -e

. /usr/share/debconf/confmodule

SETTINGS=/usr/lib/remotedesktop-host/appsettings.json
DEFAULTS=/etc/default/remotedesktop-host
PROGRAM=/usr/lib/remotedesktop-host/RemoteDesktop.HostService
CERTIFICATE_NAME=remotedesktop-signaling-host.crt
CERTIFICATE=/usr/local/share/ca-certificates/$CERTIFICATE_NAME

# The password exists only between writing it and the host command reading it. A secret must not be left behind when
# a later step fails, which is why the removal is a trap rather than a line the failure path has to remember.
PASSWORD_FILE=
cleanup_install_secrets() {
    if [ -n "$PASSWORD_FILE" ]; then
        rm -f "$PASSWORD_FILE"
        PASSWORD_FILE=
    fi
}
trap cleanup_install_secrets EXIT

# Runs a command as the signed-in user, in the environment that user's session has. HOME is how the host finds its
# data directory — run as root it would write a secret store the service never reads — and the runtime directory and
# session bus are how `systemctl --user` reaches that user's manager. XDG_DATA_HOME is cleared so the default the
# service uses ($HOME/.local/share) is the one the password is written to.
run_as_user() {
    ru_user=$1
    ru_uid=$2
    ru_home=$3
    shift 3
    runuser -u "$ru_user" -- env \
        HOME="$ru_home" \
        XDG_DATA_HOME= \
        XDG_RUNTIME_DIR="/run/user/$ru_uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$ru_uid/bus" \
        "$@"
}

case "$1" in
    configure)
        # apt preconfigures the package before unpacking it and leaves this marker behind. The same questions asked
        # again here would be the second prompt of one installation. Plain `dpkg -i` starts no preconfiguration.
        questions_marker=/run/remotedesktop-host.questions-asked
        asked_by_preconfigure=false
        if [ -e "$questions_marker" ]; then
            asked_by_preconfigure=true
            rm -f "$questions_marker"
        fi

        if [ "${DEBCONF_RECONFIGURE+set}" = "set" ] || [ "$asked_by_preconfigure" = true ]; then
            # dpkg-reconfigure (or apt's preconfiguration) has already asked; use those answers.
            :
        elif [ -x /var/lib/dpkg/info/remotedesktop-host.config ]; then
            # The config script tells a fresh install and a reinstall (ask again) from an upgrade (keep answers).
            DEBCONF_RECONFIGURE= /var/lib/dpkg/info/remotedesktop-host.config configure "${2:-}" --post-install || exit 1
        fi

        db_get remotedesktop-host/server-address || true
        address=${RET:-}
        db_get remotedesktop-host/server-certificate || true
        server_certificate=${RET:-}
        # Read the status rather than assigning RET blindly: a question that does not exist answers with a status
        # code and puts an error message in RET, and storing that as the password would be worse than storing none.
        unattended_password=
        if db_get remotedesktop-host/unattended-password; then
            unattended_password=$RET
        fi

        if [ -r "$DEFAULTS" ]; then
            # shellcheck disable=SC1090
            . "$DEFAULTS"
        fi
        [ -n "$address" ] || address=${RD_RENDEZVOUS_URI:-}
        [ -n "$server_certificate" ] || server_certificate=${RD_SERVER_CERTIFICATE:-}

        if [ -n "$address" ]; then
            case "$address" in
                ws://?*|wss://?*) ;;
                *)
                    echo "remotedesktop-host: the signaling address must start with ws:// or wss:// (got '$address')." >&2
                    exit 1
                    ;;
            esac
            case "$address" in
                *'&'*|*'#'*|*'\\'*|*'"'*|*'|'*|*[[:space:]]*)
                    echo "remotedesktop-host: the signaling address contains a character this script cannot safely substitute." >&2
                    exit 1
                    ;;
            esac

            sed "s#\"RendezvousUri\"[[:space:]]*:[[:space:]]*\"[^\"]*\"#\"RendezvousUri\": \"$address\"#" \
                "$SETTINGS" >"$SETTINGS.new"
            mv "$SETTINGS.new" "$SETTINGS"

            grep -Fq "\"$address\"" "$SETTINGS" || {
                echo "remotedesktop-host: could not set Transport:RendezvousUri in $SETTINGS." >&2
                exit 1
            }
        fi

        case "$address" in
            wss://*)
                if [ -n "$server_certificate" ]; then
                    # Read through the certificate's own directory rather than by absolute path. A purge deletes the
                    # file and the next install recreates it; that sequence can leave a stale negative directory
                    # entry, so test(1), install(1) and openssl report the absolute path missing while a lookup
                    # relative to the directory reaches the new file. The temporary copy also makes naming the
                    # destination itself harmless.
                    certificate_directory=$(dirname -- "$server_certificate")
                    certificate_name=$(basename -- "$server_certificate")
                    certificate_copy=$(mktemp) || {
                        echo "remotedesktop-host: cannot create a temporary file for the certificate." >&2
                        exit 1
                    }

                    if ! ( cd "$certificate_directory" 2>/dev/null && cat < "$certificate_name" ) >"$certificate_copy" \
                        || [ ! -s "$certificate_copy" ]; then
                        rm -f "$certificate_copy"
                        echo "remotedesktop-host: the certificate '$server_certificate' cannot be read." >&2
                        exit 1
                    fi

                    if command -v openssl >/dev/null 2>&1; then
                        openssl x509 -in "$certificate_copy" -noout 2>/dev/null || {
                            rm -f "$certificate_copy"
                            echo "remotedesktop-host: '$server_certificate' is not a PEM certificate. Pass the public half, not the key." >&2
                            exit 1
                        }
                    else
                        grep -q -- '-----BEGIN CERTIFICATE-----' "$certificate_copy" || {
                            rm -f "$certificate_copy"
                            echo "remotedesktop-host: '$server_certificate' is not a PEM certificate." >&2
                            exit 1
                        }
                    fi

                    if ! install -m 0644 "$certificate_copy" "$CERTIFICATE"; then
                        rm -f "$certificate_copy"
                        echo "remotedesktop-host: cannot install the certificate into $CERTIFICATE." >&2
                        exit 1
                    fi
                    rm -f "$certificate_copy"
                fi
                ;;
            *)
                rm -f "$CERTIFICATE"
                ;;
        esac

        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
        fi

        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi

        # See the client's postinst: trust a certificate this package was built with, and the one supplied above.
        # Run even when no certificate was supplied this time: an upgrade whose new package no longer carries one
        # leaves the old file behind as a dangling trust entry until this command notices the source is gone.
        if command -v update-ca-certificates >/dev/null 2>&1; then
            update-ca-certificates >/dev/null || {
                echo "remotedesktop-host: update-ca-certificates failed; the server certificate is not trusted." >&2
                exit 1
            }
        fi

        # The libraries this program loads by name at run time. dpkg has already refused the installation if any of
        # the declared ones were missing, so this is about the two cases dpkg cannot see: a package installed with
        # --force-depends, and the encoder, which may exist but have been built without the codec that makes it
        # useful.
        #
        # The cache is refreshed by a libc-bin trigger that runs after every package in the dpkg transaction is
        # configured, so during a first install the libraries this package pulled in are on disk but not yet in
        # `ldconfig -p`. Refresh it here (a no-op when it is already current) rather than reporting them missing.
        ldconfig 2>/dev/null || true
        missing=""
        for library in libpipewire-0.3.so.0 libei.so.1 libpulse.so.0 libavcodec.so.62 libavformat.so.62; do
            if ! ldconfig -p 2>/dev/null | grep -q "$library"; then
                missing="$missing $library"
            fi
        done

        if [ -n "$missing" ]; then
            echo "remotedesktop-host: these libraries are not in the loader's cache:$missing" >&2
            echo "  Screen sharing, control and audio each need theirs, and will fail with" >&2
            echo "  DllNotFoundException the first time they are used rather than at startup." >&2
        fi

        # The portal is what asks the person for permission. Without one there is nothing to ask, and the host will
        # offer no screens and no input at all.
        if [ ! -d /usr/share/xdg-desktop-portal/portals ] && [ ! -d /usr/lib/xdg-desktop-portal/portals ]; then
            echo "remotedesktop-host: no desktop portal is installed. Sharing this machine's screen needs one;" >&2
            echo "  install xdg-desktop-portal-gnome (or the one for your desktop) and log in again." >&2
        fi

        # --global rather than a plain enable: this unit belongs to every user rather than to root. It writes a
        # symlink under /etc/systemd/user, so each account picks it up the next time it logs in. That is also why
        # deb-systemd-helper is not used here — it only knows about system units.
        if command -v systemctl >/dev/null 2>&1; then
            # The 0.3.0 package installed a unit named remotedesktop-host.service. Its file is removed by the
            # upgrade, but the enable symlink this package's predecessor wrote is not part of any package; without
            # this it stays behind pointing at a unit that no longer exists.
            systemctl --global disable remotedesktop-host.service >/dev/null 2>&1 || true
            rm -f /etc/systemd/user/graphical-session.target.wants/remotedesktop-host.service

            systemctl --global enable app-RemoteDesktopHost.service >/dev/null 2>&1 || true
            systemctl --global daemon-reload >/dev/null 2>&1 || true

            # Enabling a user unit only affects the next login. If somebody is already signed in, start it now: the
            # client can then see the control socket and hand over, instead of waiting for a logout the package has
            # no other reason to ask for. Best-effort — a machine with no session keeps the next-login behaviour.
            #
            # The unattended password is stored on the way through, because this is the only moment the package
            # knows which users are here: the host is a user service, so each of them has a store of their own, and
            # a user who signs in later has no fixed password until one is set for them.
            if command -v loginctl >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
                password_users=0
                # A here-document rather than a pipe: a failure to store a password the operator asked for has to
                # fail the installation, and an `exit` inside a pipeline only leaves the subshell.
                while read -r uid user _; do
                    [ -n "$uid" ] || continue
                    runtime=/run/user/$uid
                    [ -S "$runtime/bus" ] || continue

                    user_home=$(getent passwd "$user" | cut -d: -f6)
                    [ -n "$user_home" ] || continue

                    if [ -n "$unattended_password" ]; then
                        PASSWORD_FILE=$(mktemp) || {
                            echo "remotedesktop-host: cannot create a temporary file for the unattended password." >&2
                            exit 1
                        }
                        chmod 600 "$PASSWORD_FILE"
                        printf '%s' "$unattended_password" >"$PASSWORD_FILE"
                        if ! chown -- "$user" "$PASSWORD_FILE"; then
                            echo "remotedesktop-host: cannot hand the unattended password file to $user." >&2
                            exit 1
                        fi

                        if run_as_user "$user" "$uid" "$user_home" \
                            "$PROGRAM" --set-fixed-password-file "$PASSWORD_FILE" >/dev/null; then
                            password_users=$((password_users + 1))
                            echo "remotedesktop-host: unattended password saved for $user."
                        else
                            echo "remotedesktop-host: could not save the unattended password for $user." >&2
                            echo "  Run as that user: $PROGRAM --set-fixed-password '<password>'" >&2
                            exit 1
                        fi
                        rm -f "$PASSWORD_FILE"
                        PASSWORD_FILE=

                        # A copy that is already running read the old password at start-up. try-restart leaves an
                        # inactive unit alone — the start below brings that one up with the new password.
                        run_as_user "$user" "$uid" "$user_home" \
                            systemctl --user try-restart app-RemoteDesktopHost.service >/dev/null 2>&1 || true
                    fi

                    run_as_user "$user" "$uid" "$user_home" \
                        systemctl --user start app-RemoteDesktopHost.service >/dev/null 2>&1 || true
                done <<EOF
$(loginctl list-users --no-legend 2>/dev/null || true)
EOF

                if [ -n "$unattended_password" ] && [ "$password_users" -eq 0 ]; then
                    echo "remotedesktop-host: nobody is signed in with a session, so the unattended password was not stored." >&2
                    echo "  Sign in as the user the host will run as, then run:" >&2
                    echo "  $PROGRAM --set-fixed-password '<password>'" >&2
                fi
            elif [ -n "$unattended_password" ]; then
                echo "remotedesktop-host: loginctl and runuser are needed to store the unattended password; it was not stored." >&2
                echo "  Run as the user the host will run as: $PROGRAM --set-fixed-password '<password>'" >&2
            fi
        elif [ -n "$unattended_password" ]; then
            echo "remotedesktop-host: systemd is not available, so the unattended password was not stored." >&2
            echo "  Run as the user the host will run as: $PROGRAM --set-fixed-password '<password>'" >&2
        fi

        # Do not leave a second copy of the password in debconf's database (/var/cache/debconf/passwords.dat). The
        # answer is emptied rather than reset so that a later upgrade treats it as "keep what is stored" instead of
        # asking again; the user's own store is now the one that matters.
        if [ -n "$unattended_password" ]; then
            db_set remotedesktop-host/unattended-password "" || true
            db_fset remotedesktop-host/unattended-password seen true || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

db_stop
exit 0
