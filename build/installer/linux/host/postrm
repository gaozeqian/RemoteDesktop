#!/bin/sh
#
# Takes the host off the list of things that start with a session.
#
# It does not stop it in anyone's running session: this script runs as root, and reaching into a user's session from
# here to stop a service would be a package reaching further than it has any business reaching. The unit is gone from
# disk by the time a running instance would next be restarted, so it ends by itself.
#
# Nothing belonging to a person is touched — their device identity, remembered grant and logs live in their own home
# directory, and removing a package is not a reason to make their machine a different device.
set -e

# Only a purge needs debconf. Removal has to work even when debconf is missing or the package is half-installed.
have_debconf=false
if [ "${1:-}" = "purge" ] && [ -f /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
    have_debconf=true
fi

case "$1" in
    remove)
        rm -f /run/remotedesktop-host.questions-asked

        if command -v systemctl >/dev/null 2>&1; then
            systemctl --global disable app-RemoteDesktopHost.service >/dev/null 2>&1 || true
            # The 0.3.0 unit name. Its file is gone, but an enable symlink written by that version is not part of any
            # package and has to be removed here.
            systemctl --global disable remotedesktop-host.service >/dev/null 2>&1 || true
        fi
        rm -f /etc/systemd/user/graphical-session.target.wants/remotedesktop-host.service

        # See the client's postrm: the trust entry this package may have added goes with it.
        rm -f /usr/local/share/ca-certificates/remotedesktop-signaling-host.crt
        if command -v update-ca-certificates >/dev/null 2>&1; then
            update-ca-certificates >/dev/null 2>&1 || true
        fi
        ;;

    purge)
        # A purge followed by an install is a new installation: ask the questions again.
        if [ "$have_debconf" = true ]; then
            db_purge || true
            db_stop
        fi
        rm -f /run/remotedesktop-host.questions-asked
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
