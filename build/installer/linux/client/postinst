#!/bin/sh
#
# Applies the answers from the installation questions: the signaling address goes into the settings next to the
# program, and a server certificate the operator brought goes into the system trust store. Then tells the desktop
# about the new launcher and icons.
#
# Nothing is started and nothing is enabled. This is a program somebody opens, not a service, and a package that
# launched a window at install time would be opening a connection dialog at a moment the person did not ask for one.
set -e

. /usr/share/debconf/confmodule

SETTINGS=/usr/lib/remotedesktop-client/appsettings.json
DEFAULTS=/etc/default/remotedesktop-client
CERTIFICATE_NAME=remotedesktop-signaling-client.crt
CERTIFICATE=/usr/local/share/ca-certificates/$CERTIFICATE_NAME

case "$1" in
    configure)
        # apt preconfigures the package before unpacking it and leaves this marker behind. The same questions asked
        # again here would be the second prompt of one installation. Plain `dpkg -i` starts no preconfiguration.
        questions_marker=/run/remotedesktop-client.questions-asked
        asked_by_preconfigure=false
        if [ -e "$questions_marker" ]; then
            asked_by_preconfigure=true
            rm -f "$questions_marker"
        fi

        if [ "${DEBCONF_RECONFIGURE+set}" = "set" ] || [ "$asked_by_preconfigure" = true ]; then
            # dpkg-reconfigure (or apt's preconfiguration) has already asked; use those answers.
            :
        elif [ -x /var/lib/dpkg/info/remotedesktop-client.config ]; then
            # The config script tells a fresh install and a reinstall (ask again) from an upgrade (keep answers).
            DEBCONF_RECONFIGURE= /var/lib/dpkg/info/remotedesktop-client.config configure "${2:-}" --post-install || exit 1
        fi

        db_get remotedesktop-client/server-address || true
        address=${RET:-}
        db_get remotedesktop-client/server-certificate || true
        server_certificate=${RET:-}

        if [ -r "$DEFAULTS" ]; then
            # shellcheck disable=SC1090
            . "$DEFAULTS"
        fi
        [ -n "$address" ] || address=${RD_RENDEZVOUS_URI:-}
        [ -n "$server_certificate" ] || server_certificate=${RD_SERVER_CERTIFICATE:-}

        if [ -n "$address" ]; then
            case "$address" in
                ws://?*|wss://?*) ;;
                *)
                    echo "remotedesktop-client: the signaling address must start with ws:// or wss:// (got '$address')." >&2
                    exit 1
                    ;;
            esac
            case "$address" in
                *'&'*|*'#'*|*'\\'*|*'"'*|*'|'*|*[[:space:]]*)
                    echo "remotedesktop-client: the signaling address contains a character this script cannot safely substitute." >&2
                    exit 1
                    ;;
            esac

            sed "s#\"RendezvousUri\"[[:space:]]*:[[:space:]]*\"[^\"]*\"#\"RendezvousUri\": \"$address\"#" \
                "$SETTINGS" >"$SETTINGS.new"
            mv "$SETTINGS.new" "$SETTINGS"

            grep -Fq "\"$address\"" "$SETTINGS" || {
                echo "remotedesktop-client: could not set Transport:RendezvousUri in $SETTINGS." >&2
                exit 1
            }
        fi

        # A certificate is only needed when the address asks for TLS, and only when it is not one a public authority
        # signed. An empty answer therefore means "nothing to import", not "remove what is there".
        case "$address" in
            wss://*)
                if [ -n "$server_certificate" ]; then
                    # Read through the certificate's own directory rather than by absolute path. A purge deletes the
                    # file and the next install recreates it; that sequence can leave a stale negative directory
                    # entry, so test(1), install(1) and openssl report the absolute path missing while a lookup
                    # relative to the directory reaches the new file. The temporary copy also makes naming the
                    # destination itself harmless.
                    certificate_directory=$(dirname -- "$server_certificate")
                    certificate_name=$(basename -- "$server_certificate")
                    certificate_copy=$(mktemp) || {
                        echo "remotedesktop-client: cannot create a temporary file for the certificate." >&2
                        exit 1
                    }

                    if ! ( cd "$certificate_directory" 2>/dev/null && cat < "$certificate_name" ) >"$certificate_copy" \
                        || [ ! -s "$certificate_copy" ]; then
                        rm -f "$certificate_copy"
                        echo "remotedesktop-client: the certificate '$server_certificate' cannot be read." >&2
                        exit 1
                    fi

                    if command -v openssl >/dev/null 2>&1; then
                        openssl x509 -in "$certificate_copy" -noout 2>/dev/null || {
                            rm -f "$certificate_copy"
                            echo "remotedesktop-client: '$server_certificate' is not a PEM certificate. Pass the public half, not the key." >&2
                            exit 1
                        }
                    else
                        grep -q -- '-----BEGIN CERTIFICATE-----' "$certificate_copy" || {
                            rm -f "$certificate_copy"
                            echo "remotedesktop-client: '$server_certificate' is not a PEM certificate." >&2
                            exit 1
                        }
                    fi

                    if ! install -m 0644 "$certificate_copy" "$CERTIFICATE"; then
                        rm -f "$certificate_copy"
                        echo "remotedesktop-client: cannot install the certificate into $CERTIFICATE." >&2
                        exit 1
                    fi
                    rm -f "$certificate_copy"
                fi
                ;;
        esac

        # Both of these only update caches; a desktop that is not running, or one that cannot update them, is not a
        # reason for the installation to fail.
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
        fi

        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi

        # Trust a certificate this package was built with, and the one the operator supplied above. The update only
        # touches the system CA bundle. It is not optional: an installation that asked for wss:// and silently did
        # not trust the certificate would fail at the first connection, long after anybody could connect the two.
        # Run even when no certificate was supplied this time: an upgrade whose new package no longer carries one
        # leaves the old file behind as a dangling trust entry until this command notices the source is gone.
        if command -v update-ca-certificates >/dev/null 2>&1; then
            update-ca-certificates >/dev/null || {
                echo "remotedesktop-client: update-ca-certificates failed; the server certificate is not trusted." >&2
                exit 1
            }
        fi

        # The libraries the program loads by name at run time. dpkg has already refused the installation if any of
        # the declared ones were missing, so this is about the two cases dpkg cannot see: a package installed with
        # --force-depends, and the libraries the in-process controlled end reaches for (PipeWire, libei) — a client
        # without the host package still offers itself as a controlled end while it runs.
        #
        # The cache is refreshed by a libc-bin trigger that runs after every package in the dpkg transaction is
        # configured, so during a first install the libraries this package pulled in are on disk but not yet in
        # `ldconfig -p`. Refresh it here (a no-op when it is already current) rather than reporting them missing.
        ldconfig 2>/dev/null || true
        missing=""
        for library in libavcodec.so.62 libavformat.so.62 libX11.so.6 libGL.so.1 libpipewire-0.3.so.0 libei.so.1; do
            if ! ldconfig -p 2>/dev/null | grep -q "$library"; then
                missing="$missing $library"
            fi
        done

        if [ -n "$missing" ]; then
            echo "remotedesktop-client: these libraries are not in the loader's cache:$missing" >&2
            echo "  The window will open and then show nothing, or fail when a picture arrives." >&2
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

db_stop
exit 0
