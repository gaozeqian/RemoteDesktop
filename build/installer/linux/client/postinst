#!/bin/sh
#
# Tells the desktop about the new launcher and icons.
#
# Nothing is started and nothing is enabled. This is a program somebody opens, not a service, and a package that
# launched a window at install time would be opening a connection dialog at a moment the person did not ask for one.
set -e

case "$1" in
    configure)
        # Both of these only update caches; a desktop that is not running, or one that cannot update them, is not a
        # reason for the installation to fail.
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
        fi

        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi

        # A site-specific build can carry the signaling server's self-signed certificate. Trust it as a root so
        # wss:// works without the person importing it by hand. The update only touches the system CA bundle.
        if [ -f /usr/local/share/ca-certificates/remotedesktop-signaling-client.crt ] &&
            command -v update-ca-certificates >/dev/null 2>&1; then
            update-ca-certificates >/dev/null 2>&1 || true
        fi

        # The same two libraries the host needs, for the same reason: the loader will not notice them missing until
        # the picture is already supposed to be on screen.
        missing=""
        for library in libavcodec.so.62 libX11.so.6 libGL.so.1; do
            if ! ldconfig -p 2>/dev/null | grep -q "$library"; then
                missing="$missing $library"
            fi
        done

        if [ -n "$missing" ]; then
            echo "remotedesktop-client: these libraries are not in the loader's cache:$missing" >&2
            echo "  The window will open and then show nothing, or fail when a picture arrives." >&2
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
