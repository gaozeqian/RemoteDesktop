[Desktop Entry]
Type=Application
# The product name is not translated. A localized Name here made the launcher call the program 远程桌面 while the
# window, the installer and the store listing all say Remote Desktop — the same product under two names. The
# description and keywords stay translated, because those are read by search rather than shown as the name.
Name=Remote Desktop
Comment=Control another computer
Comment[zh_CN]=远程控制另一台电脑
# %u passes the remotedesktop:// URL through as an argument. The MimeType line is what makes the desktop offer this
# program for the scheme; the client hands the URL to a window that is already open over a pipe, so a link never starts
# a second client that would fight the first over the same controller identity.
Exec=/usr/bin/remotedesktop %u
MimeType=x-scheme-handler/remotedesktop;
Icon=remotedesktop
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;desktop;vnc;rdp;
Keywords[zh_CN]=远程;桌面;控制;
StartupNotify=true
# The window some desktops match against; it has to be the name the process actually sets, or the icon in the dock and
# the one in this file are two different pictures.
StartupWMClass=RemoteDesktop.Client
