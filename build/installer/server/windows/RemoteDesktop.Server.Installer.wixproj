<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <!-- WiX v5 on purpose: from v6 the Open Source Maintenance Fee applies to commercial use. v5 gets no more
         community fixes, so the installer is kept to standard features (no custom actions of our own beyond calling
         the server executable) to keep a later move to another tool cheap. Same choice as the client installer. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>RemoteDesktop.Server-$(ProductVersion)-x64</OutputName>
    <OutputType>Package</OutputType>
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Passed by build-server-installer.ps1: -p:ProductVersion=0.2.1 -p:SourceRoot=<publish folder>
         [-p:DefaultRendezvousUrl=...] -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <!-- What the signaling server listens on: the address baked into the installed Rendezvous\appsettings.json (read
         back from the publish output by build-server-installer.ps1) and the default of the RENDEZVOUSURL property. -->
    <DefaultRendezvousUrl Condition="'$(DefaultRendezvousUrl)' == ''">http://0.0.0.0:5080</DefaultRendezvousUrl>
    <DefineConstants>ProductVersion=$(ProductVersion);SourceRoot=$(SourceRoot);DefaultRendezvousUrl=$(DefaultRendezvousUrl)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- The WiX SDK already compiles every *.wxs in this folder (EnableDefaultCompileItems); listing them again
       would compile each one twice and the linker would see two packages. -->

  <Target Name="RequireGeneratedFiles" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Files.generated.wxs')"
           Text="Files.generated.wxs is missing. Run build\installer\server\windows\build-server-installer.ps1, which publishes the servers and generates the file list from the publish output." />
    <Error Condition="'$(SourceRoot)' == ''"
           Text="SourceRoot is not set. Run build\installer\server\windows\build-server-installer.ps1, or pass -p:SourceRoot=&lt;publish folder&gt;." />
  </Target>

</Project>
