<?xml version="1.0" encoding="utf-8"?>
<!--
  The components that need more than "a file": the two services, the inbound firewall rules that let clients reach
  them, and the two settings files. Everything else is generated from the publish output into Files.generated.wxs.

  The two server folders (Rendezvous, Relay) are declared by that generated file, which mirrors the publish output;
  build-server-installer.ps1 tells the generator to name those two directories RendezvousFolder and RelayFolder, so
  the components here can be placed in them regardless of the order the publish output happens to be read in.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>
    <DirectoryRef Id="RendezvousFolder">

      <!-- The signaling server: device codes, presence, and the connect requests that put two peers in touch. -->
      <Component Id="RendezvousService" Guid="8b2c3d4e-5f6a-4b7c-9d0e-1f2a3b4c5d6e">
        <File Id="RendezvousExeFile" Source="$(var.SourceRoot)\Rendezvous\RemoteDesktop.Server.Rendezvous.exe" KeyPath="yes" />
        <ServiceInstall Id="RendezvousServiceInstall"
                        Name="RemoteDesktopRendezvous"
                        DisplayName="Remote Desktop Rendezvous"
                        Description="Connects Remote Desktop devices to each other (signaling)."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <!-- Started when installed, stopped on uninstall and on upgrades, so the executable is never in use. The same
             service name is what the program checks for when it decides whether it was started as a service or from a
             console (Program.cs), so the two have to keep agreeing. -->
        <ServiceControl Id="RendezvousServiceControl" Name="RemoteDesktopRendezvous" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- Restarted three times over, five seconds apart, with the count cleared after a day of running. A service
             that dies on a machine nobody is watching is a server that stays down until somebody notices, and the
             reset period is what keeps a server that crashed once — months ago, at a busy moment - from being counted
             with one that is crash-looping right now. -->
        <util:ServiceConfig ServiceName="RemoteDesktopRendezvous"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </Component>

      <!-- Read at every start-up, and written by the configuration step below. Never overwritten: it carries what this
           deployment was told (the address clients relay through, an operator's PostgreSQL connection string) and the
           generated relay key, none of which an upgrade may put back to the built-in defaults. Removing the product
           removes it; a repair does not put the packaged copy back over an edited one. -->
      <Component Id="RendezvousSettings" Guid="be5f6a7b-8c9d-4e0f-9a1b-4c5d6e7f8091" NeverOverwrite="yes">
        <File Id="RendezvousAppSettingsFile" Source="$(var.SourceRoot)\Rendezvous\appsettings.json" KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <DirectoryRef Id="RelayFolder">

      <!-- The relay: forwards UDP between two peers that could not reach each other directly, without reading what it
           forwards. Its port and the key it shares with the signaling server come from the same configuration step. -->
      <Component Id="RelayService" Guid="9c3d4e5f-6a7b-4c8d-9e0f-2a3b4c5d6e7f">
        <File Id="RelayExeFile" Source="$(var.SourceRoot)\Relay\RemoteDesktop.Server.Relay.exe" KeyPath="yes" />
        <ServiceInstall Id="RelayServiceInstall"
                        Name="RemoteDesktopRelay"
                        DisplayName="Remote Desktop Relay"
                        Description="Relays Remote Desktop connections between devices that cannot reach each other."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <ServiceControl Id="RelayServiceControl" Name="RemoteDesktopRelay" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- The same for the relay; see the note on the signaling server's failure actions above. -->
        <util:ServiceConfig ServiceName="RemoteDesktopRelay"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </Component>

      <!-- The other half of the shared key; see the comment on the signaling server's settings above. -->
      <Component Id="RelaySettings" Guid="cf6a7b8c-9d0e-4f1a-8b2c-5d6e7f809102" NeverOverwrite="yes">
>        <File Id="RelayAppSettingsFile" Source="$(var.SourceRoot)\Relay\appsettings.json" KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">

      <!--
        The three inbound rules in a component of their own, keyed by a registry value rather than by one of the files
        or the services they are about. Two reasons, both of them from how Windows Installer works rather than from
        taste:

          * a firewall rule is a rule about a program, not a property of it: putting the rules inside the service
            components would tie "the rule was added" to "the service is installed", and a repair of one would touch
            the other;
          * NOFIREWALL=1 has to be able to leave them out while the services are still installed, which is what the
            condition on the component is for - a condition that is false installs none of what the component holds,
            and the same component is then simply absent from the machine (it is not an error for a component to be
            conditional, the way it is for a component that is missing from the package entirely).

        A failure to add a rule must not fail the installation (IgnoreFailure): without it the server still listens,
        it is simply unreachable from elsewhere until an administrator adds the rule by hand - which is exactly the
        case NOFIREWALL exists for.
      -->
      <Component Id="FirewallRules" Guid="ad4e5f6a-7b8c-4d9e-8f0a-3b4c5d6e7f80" Condition="NOFIREWALL&lt;&gt;&quot;1&quot;">
        <RegistryValue Root="HKLM" Key="Software\RemoteDesktop" Name="ServerFirewallRules" Type="integer" Value="1" KeyPath="yes" />

        <!-- Signaling: the WebSocket the clients and the devices keep open. The rule names the port as well as the
             program - "this program, on this port" is narrower than "this program, on anything it likes" - which
             means the rule is written for the default port. A deployment that moves a server (RENDEZVOUSURL, the
             relay's port) opens its own rule for the port it moved to; these three stay where the defaults are. -->
        <firewall:FirewallException Id="SignalingTcp"
                                    Name="Remote Desktop Rendezvous (TCP 5080)"
                                    Description="Incoming signaling connections from Remote Desktop clients and devices."
                                    Program="[#RendezvousExeFile]" Port="5080"
                                    Protocol="tcp" Profile="all" Scope="any" IgnoreFailure="yes" />

        <!-- Address reflection: the UDP exchange that tells each peer how the other one appears from the outside, which
             is what lets them try a direct connection first. -->
        <firewall:FirewallException Id="SignalingReflectionUdp"
                                    Name="Remote Desktop Rendezvous address reflection (UDP 5081)"
                                    Description="Incoming address-reflection packets, used to find each peer's address as seen from the internet."
                                    Program="[#RendezvousExeFile]" Port="5081"
                                    Protocol="udp" Profile="all" Scope="any" IgnoreFailure="yes" />

        <!-- The relay's UDP port: the traffic that could not go directly goes through here instead. -->
        <firewall:FirewallException Id="RelayUdp"
                                    Name="Remote Desktop Relay (UDP 5082)"
                                    Description="Relayed Remote Desktop traffic from devices that cannot reach each other directly."
                                    Program="[#RelayExeFile]" Port="5082"
                                    Protocol="udp" Profile="all" Scope="any" IgnoreFailure="yes" />
      </Component>

    </DirectoryRef>

    <!--
      The steps that need elevated rights go through the rendezvous executable, which the installer has just put in
      place. All are deferred, run as the system, and are safe to repeat. It is the rendezvous executable that carries
      the step (and not the relay's) because it is the one the installer has a path to and because what it writes
      belongs to both servers: they share the key that signs the relay tickets.

      They live in this fragment, next to the components, on purpose: WiX 5.0.2 drops a fragment that holds no
      component when linking (silently), which would quietly leave the installer without its custom actions.
    -->
    <!--
      These run through System32\cmd.exe instead of using the server executable as the action's own target, and they
      ignore the exit code. Both details come from a real failed upgrade of the client installer:

        * A type 18 action (the packaged file as the target) fails the whole installation with error 1721 when Windows
          cannot start that file, which is what happens when an earlier version's file is waiting for a reboot because
          a process still held it. "ignore" covers a non-zero exit code, not a failure to launch. Going through
          cmd.exe turns every failure, including "the file is not there", into an exit code that is ignored.
        * The work is best-effort by design: the addresses are already baked into the two appsettings.json files when
          the installer is built, and the same step can be repeated by hand at any time, by running the rendezvous
          executable with its configure-system command and the same arguments.

      A configuration step must never leave a half-installed product behind.
    -->
    <CustomAction Id="ConfigureSystem"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c &quot;&quot;[INSTALLFOLDER]Rendezvous\RemoteDesktop.Server.Rendezvous.exe&quot; --configure-system --urls &quot;[RENDEZVOUSURL]&quot; --relay-endpoint &quot;[RELAYPUBLICENDPOINT]&quot; --relay-key &quot;[RELAYSHAREDKEY]&quot; --postgres &quot;[POSTGRESCONNECTIONSTRING]&quot;&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!--
      The four arguments the two command lines here have in common - the address, the relay endpoint, the key and the
      database - set once into a property, because the certificate's line cannot afford to spell them out a second
      time (the note under it has the numbers). The line above keeps its own copy written out in full, because it fits.

      The property is declared in Package.wxs with Secure="yes", and that is what makes it readable here: a deferred
      action is run from the installation script, past the elevation boundary, and only the properties in the secure
      list have their values copied into that script. Without it this line and the one above would disagree - the
      certificate's installation would configure the four values to their defaults rather than to what was passed.

      What it holds is the text above, with the property values as they stand when the setter is reached; the setter
      runs in the immediate pass, before either command line is written into the script, which is also how the
      properties in the line above reach it.
    -->
    <CustomAction Id="SetConfigureArguments"
                  Property="CONFIGUREARGUMENTS"
                  Value="--urls &quot;[RENDEZVOUSURL]&quot; --relay-endpoint &quot;[RELAYPUBLICENDPOINT]&quot; --relay-key &quot;[RELAYSHAREDKEY]&quot; --postgres &quot;[POSTGRESCONNECTIONSTRING]&quot;"
                  Execute="immediate" />

    <!--
      The same command line plus the certificate, for an installation that was given one. A second action rather than
      one command line that always carries the two arguments: the server reads an empty password as "no password", but
      an empty string in the place of a path is a value it would have to guess about, so the certificate's arguments
      are only put on a command line that has a path to put there. Which of the two runs is decided by
      TLSCERTIFICATEPATH: "auto" (what the package defaults to) is this installer's "there is no certificate", and
      anything else that is not empty is a path.

      The four arguments the two lines share are read out of [CONFIGUREARGUMENTS] here, set by the action just above -
      see the note there for why that property has to be secure for this line to receive anything at all.

      They are read from a property because of a limit rather than for brevity: a column of the installer database
      holds 265 characters (ICE03 calls anything longer a string overflow), this line with all six arguments written
      out is 332, and even with the installed file's own key standing in for the path - [#RendezvousExeFile] instead
      of [INSTALLFOLDER]Rendezvous\... - it is 291, which does not fit either. With the property standing in for the
      four shared ones it is 216, and the certificate's own two stay spelled out here, where a reader comes looking
      for them.
    -->
    <CustomAction Id="ConfigureSystemWithTls"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c &quot;&quot;[INSTALLFOLDER]Rendezvous\RemoteDesktop.Server.Rendezvous.exe&quot; --configure-system [CONFIGUREARGUMENTS] --tls-certificate &quot;[TLSCERTIFICATEPATH]&quot; --tls-password &quot;[TLSCERTIFICATEPASSWORD]&quot;&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!--
        Installing only: "NOT REMOVE" is what decides that, and nothing about a removal may be added to it.

        An earlier version of the client installer's line read "NOT REMOVE OR UPGRADINGPRODUCTCODE", meaning to cover
        the new product of an upgrade. It did the opposite: during a major upgrade the installer sets
        UPGRADINGPRODUCTCODE while it *removes the old product*, so the condition became true there too, and the old
        product ran this action after its own files had been deleted. Windows then reported error 1721 ("a program
        required for this install to complete could not be run") for an executable that was no longer there, and the
        installation rolled back with 1603 - three upgrades in a row failed exactly that way.

        During an upgrade the new product installs with REMOVE empty, so "NOT REMOVE" is already true when it should
        be, and false while the old product is being removed.

        The second half of each condition below is not about removal at all: it picks which of the two command lines
        runs. The first is for TLSCERTIFICATEPATH saying "auto" (what the package defaults to) or holding nothing at
        all, the second for it naming a file; between them every value it can have is covered, so an installation
        neither configures twice nor leaves the four shared values at their defaults. It reads only properties this
        installer always sets, never one the installer engine sets by itself, which is what UPGRADINGPRODUCTCODE was.
      -->
      <!-- The property the second line reads is put in place immediately before it, and this is the only ordering that
           matters among the three: the setter runs in the immediate pass, the two command lines are deferred and are
           built (with the property as it stands then) as their turn comes. -->
      <Custom Action="SetConfigureArguments"
              Before="ConfigureSystem"
              Condition="NOT REMOVE" />
      <Custom Action="ConfigureSystem"
              After="InstallFiles"
              Condition="NOT REMOVE AND (TLSCERTIFICATEPATH=&quot;auto&quot; OR TLSCERTIFICATEPATH=&quot;&quot;)" />
      <Custom Action="ConfigureSystemWithTls"
              After="ConfigureSystem"
              Condition="NOT REMOVE AND TLSCERTIFICATEPATH&lt;&gt;&quot;auto&quot; AND TLSCERTIFICATEPATH&lt;&gt;&quot;&quot;" />
    </InstallExecuteSequence>

    <!-- ==========================================================================================================
         The one page of this wizard that asks anything.

         Everything these controls write is a property the deferred action above already reads, so the page is the
         only new thing: without it a double-click install takes every default, and the defaults are "no database"
         and "plain http" — the two settings whose consequences are worst (device codes that change on every restart,
         and device codes and relay tickets readable by anyone on the way) and whose warnings end up in a log file
         nobody installing by double-click ever opens.

         It goes through WixUI_InstallDir's sequence rather than replacing it: the standard dialogs stay, this one is
         wired in after the install folder has been chosen.
         ========================================================================================================== -->
    <!-- ==========================================================================================================
         The start menu entry: "how do I change this", pointed at the page that answers it.

         Keyed by a registry value under HKCU because a shortcut is per-user data even when the program is installed
         for everybody (ICE43/ICE57) — the same shape the client package uses for its own shortcut.
         ========================================================================================================== -->
    <DirectoryRef Id="ServerShortcutFolder">
      <Component Id="ServerShortcut" Guid="d17b8c9d-0e1f-4a2b-9c3d-4e5f6a7b8c9d">
        <Shortcut Id="HowToConfigureLink" Name="服务器配置说明"
                  Description="How to change the database, relay address and TLS settings of these servers"
                  Target="[INSTALLFOLDER]如何配置.txt" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RemoteDesktop\Server" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <!-- Windows Installer only removes folders it is told about. -->
        <RemoveFolder Id="RemoveServerShortcutFolder" Directory="ServerShortcutFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- The custom actions the settings page calls, packed into one DLL by the build (net48: msiexec hosts the .NET
         Framework runtime, so this is the only kind of assembly it can load). They are immediate actions, which is the
         whole point — they run inside msiexec, where the properties the page wrote are readable and a property they
         set is what the page shows next. -->
    <Binary Id="PageActions" SourceFile="$(var.CustomActionsPath)" />
    <CustomAction Id="BrowseForCertificate" BinaryRef="PageActions" DllEntry="BrowseForCertificate" Execute="immediate" Return="ignore" />

    <UI>

    <Dialog Id="ServerSettingsDlg" Width="370" Height="340" Title="[ProductName] 安装向导">
      <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}服务器设置" />
      <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="以下三项都可以留空，装完也能改（见安装目录下的 configure-server.ps1）。" />
      <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
      <Control Id="BottomLine" Type="Line" X="0" Y="304" Width="370" Height="0" />

      <!-- The database: optional, but leaving it out is the single most consequential default in this package.

           The box arrives filled with a template pointing at this machine, because a connection string is a shape
           nobody remembers and an empty box teaches nothing. That is only safe because of the check below: whatever
           is in this box is tried before anything is installed, and the install stops if it does not answer. -->
      <Control Id="PostgresLabel" Type="Text" X="20" Y="52" Width="330" Height="12" NoPrefix="yes" Text="数据库连接串（留空 = 不使用数据库；仅支持 PostgreSQL）" />
      <Control Id="PostgresEdit" Type="Edit" X="20" Y="64" Width="330" Height="16" Property="POSTGRESCONNECTIONSTRING" />
      <Control Id="PostgresNote" Type="Text" X="20" Y="82" Width="330" Height="24" NoPrefix="yes" Text="例：Host=db;Port=5432;Database=remotedesktop;Username=rd;Password=... 用内存时设备代码在信令服务重启后会全部改变。" />
      <Control Id="SkipCheckBox" Type="CheckBox" X="20" Y="106" Width="330" Height="14" Property="DBCHECKOVERRIDE" CheckBoxValue="1" Text="数据库连不上也继续安装（设置照写，服务器可能起不来）" />

      <!-- Where clients are told to reach the relay. "auto" picks this machine's first non-loopback address, which on
           a machine with a VPN is the VPN's. -->
      <Control Id="RelayLabel" Type="Text" X="20" Y="100" Width="330" Height="12" NoPrefix="yes" Text="中继公网地址（让客户端去哪里找中继）。例：203.0.113.10:5082" />
      <Control Id="RelayEdit" Type="Edit" X="20" Y="112" Width="330" Height="16" Property="RELAYPUBLICENDPOINT" Text="[RELAYPUBLICENDPOINT]" />
      <Control Id="RelayNote" Type="Text" X="20" Y="130" Width="330" Height="12" NoPrefix="yes" Text="auto = 本机第一个非回环地址（有 VPN 或虚拟网卡时会选错）；中继在另一台机器上时填那台的 IP:端口。" />

      <!-- TLS: three choices, and the middle one is why this page is worth having. -->
      <Control Id="TlsLabel" Type="Text" X="20" Y="148" Width="330" Height="12" NoPrefix="yes" Text="信令是否走 TLS" />
      <!-- Flat, not nested: in this schema the group is a control of its own and each button is a sibling that names
           the group's property. -->
      <Control Id="TlsChoice" Type="RadioButtonGroup" X="20" Y="160" Width="330" Height="46" Property="TLSCHOICE">
        <RadioButtonGroup Property="TLSCHOICE">
          <RadioButton Value="none" X="4" Y="2" Width="322" Height="13" Text="不启用：明文 http，设备代码与中继票据在途中可被读取" />
          <RadioButton Value="generate" X="4" Y="17" Width="322" Height="13" Text="自动生成一张自签名证书并启用 https（推荐）" />
          <RadioButton Value="file" X="4" Y="32" Width="322" Height="13" Text="使用已有的证书文件" />
        </RadioButtonGroup>
      </Control>

      <!-- Two lines, one field each: on one line the password box came out about thirty pixels wide, which is not a
           field anybody can type a password into. -->
      <Control Id="TlsPathLabel" Type="Text" X="34" Y="212" Width="312" Height="12" NoPrefix="yes" Text="证书文件路径（.pfx）" />
      <Control Id="TlsPathEdit" Type="Edit" X="34" Y="224" Width="240" Height="16" Property="TLSCERTIFICATEPATH" Text="[TLSCERTIFICATEPATH]" />
      <!-- Windows Installer's own browse dialog picks folders, not files, so this button runs our own action, which
           puts the chosen path straight into the property the page shows. -->
      <Control Id="TlsBrowseButton" Type="PushButton" X="278" Y="224" Width="72" Height="16" Text="浏览…">
        <Publish Event="DoAction" Value="BrowseForCertificate" />
      </Control>
      <Control Id="TlsPasswordLabel" Type="Text" X="34" Y="244" Width="312" Height="12" NoPrefix="yes" Text="证书口令（没有口令就留空）" />
      <Control Id="TlsPasswordEdit" Type="Edit" X="34" Y="256" Width="316" Height="16" Password="yes" Property="TLSCERTIFICATEPASSWORD" />
      <Control Id="TlsNote" Type="Text" X="20" Y="278" Width="330" Height="24" NoPrefix="yes" Text="自动生成的证书放在本机证书存储，公钥导出到安装目录 tls\signaling.cer —— 客户端要信任它，否则会拒绝连接。" />

      <Control Id="Back" Type="PushButton" X="180" Y="313" Width="56" Height="17" Text="!(loc.WixUIBack)">
        <Publish Event="NewDialog" Value="InstallDirDlg" />
      </Control>
      <Control Id="Next" Type="PushButton" X="236" Y="313" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
        <!-- The database is tried before anything is installed, and a connection that does not answer stops the
             wizard here — on this page, where the value that failed is still in front of whoever typed it. This is
             the one setting whose being wrong makes the servers fail to start rather than fall back to something
             that works, which is why it is a gate and the others are not. The checkbox above is the way through for
             a database that is simply not up yet. -->
        
        
        <Publish Event="SetProperty" Value="auto" Order="1" Condition="TLSCHOICE = &quot;none&quot;" />
        <Publish Event="SetProperty" Value="generate" Order="2" Condition="TLSCHOICE = &quot;generate&quot;" />
        <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="1" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="313" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

      <!-- Into the wizard, after the folder has been chosen. The dialog set's own transition to VerifyReadyDlg stays
           where it is, with a lower ordering: the last matching transition is the one that takes effect, which is why
           these carry a higher Order than the built-in ones (the dialog set uses 1 and 4). -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServerSettingsDlg" Order="5" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerSettingsDlg" Order="5" Condition="1" />
    </UI>
  </Fragment>

</Wix>
