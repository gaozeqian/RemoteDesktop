<?xml version="1.0" encoding="utf-8"?>
<!--
  Tells SfxCA's native host which runtime to start, and has to be packed into the custom action DLL (see the Content
  item in the .csproj) because that host reads it out of the package it extracts itself into, not off the disk.

  Without this file the host asks for the .NET 2.0 CLR, which no longer exists on any supported Windows, and gives up
  with error 0x80131700 before the CLR - and so before any of our code - has started. The symptom is the worst kind:
  the action fails in two milliseconds, Windows Installer logs only "Error 2896: Executing action X failed", and not
  one line of our own logging appears, because there is nothing running to write it.

  "v4.0" means 4.0 or later, so this is also what lets the assembly be built for net48.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
