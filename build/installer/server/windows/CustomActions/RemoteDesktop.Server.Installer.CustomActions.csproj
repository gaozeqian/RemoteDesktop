<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A .NET Framework class library on purpose, and the only one in this repository: Windows Installer hosts the .NET
    Framework runtime inside msiexec, so a custom action assembly has to be something that runtime can load. The DTF
    packages themselves are netstandard2.0, which a net48 project can reference — the dependency goes one way only,
    so net10 code cannot be referenced from here (and Npgsql 9 does not support net48 at all, which is why the check
    this project runs is a TCP reachability test rather than the full one the server does at start-up).

    Not in RemoteDesktop.slnx: this is installer plumbing, not product code, and the solution's projects are all
    net10. It is built by build-server-installer.ps1 alongside the package.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Platform, not PlatformTarget: the DTF targets choose SfxCA's *native* host stub with
         Condition="'$(Platform)' == 'x64'" and fall through to the x86 stub otherwise, so on the default AnyCPU this
         packs into a 32-bit DLL. The package is InstallerPlatform=x64, so msiexec is 64-bit and cannot load that at
         all — the custom action then fails in two milliseconds with "Return value 3" and not one line in the log,
         because no managed code ever ran and so nothing in this assembly can report why. PlatformTarget=x64 does not
         help here; the targets never read it. Changing this moves the output to bin\x64\Release\net48. -->
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="5.0.2" />
  </ItemGroup>

  <!-- Content items are what the DTF targets pack into the DLL alongside the assembly, so this is how the runtime
       version the host has to start gets in there. Without it the action cannot run at all - see the file itself. -->
  <ItemGroup>
    <Content Include="CustomAction.config" />
  </ItemGroup>

</Project>
