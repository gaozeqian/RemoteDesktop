<Project>

  <!--
    Deliberately empty. The repository's Directory.Build.props sets TargetFramework net10.0, the C# analyzers and
    central package management, none of which apply to a WiX project. MSBuild only imports the nearest file, so this
    one blocks that import. Everything the installer project needs is set in RemoteDesktop.Installer.wixproj.
  -->

</Project>
