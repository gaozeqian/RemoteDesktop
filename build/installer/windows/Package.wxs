<?xml version="1.0" encoding="utf-8"?>
<!--
  One installer per platform: this MSI installs the client, the background service and the session agent into one
  folder. The service is what makes this computer reachable; the client is both the window of this computer and the
  controller of others. Everything else (files, dialogs) lives in Components.wxs and Files.generated.wxs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="RemoteDesktop" Manufacturer="RemoteDesktop" Version="$(var.ProductVersion)"
           UpgradeCode="6f3c1a26-9b57-4d0e-8f2a-5c7b1e4d9a30"
           Scope="perMachine" Compressed="yes" InstallerVersion="500">

    <SummaryInformation Description="Remote desktop: control, file transfer, terminal and camera. Chinese and English UI." />

    <!-- Same-version installs upgrade in place, which is what rebuilding 0.1.0 while testing needs. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of RemoteDesktop is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The server this installation talks to. The default is the address baked in when the installer was built
         (build-installer.ps1 -RendezvousUri); it can be given at install time instead:
         msiexec /i <msi> RENDEZVOUSURI=ws://rd.example.com:5080/ws
         It has a value (rather than none) on purpose: a property without one is left out of the property table
         altogether, and the deferred custom action that writes it into appsettings.json would find nothing.
         Secure so that the deferred action receives it. -->
    <Property Id="RENDEZVOUSURI" Value="$(var.DefaultRendezvousUri)" Secure="yes" />

    <!-- Uninstalling keeps the device identity and logs (a reinstall then keeps the same device code) unless the person
         asks for them to go: msiexec /x ... REMOVEDATA=1 -->
    <Property Id="REMOVEDATA" Value="0" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RemoteDesktop" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="RemoteDesktop" />
    </StandardDirectory>

    <Feature Id="Main" Title="RemoteDesktop" Level="1" AllowAbsent="no">
      <!-- The window of this computer and the controller for others. -->
      <ComponentRef Id="ClientExe" />
      <!-- The service that accepts connections, plus the agent that does the work inside the session. -->
      <ComponentRef Id="HostServiceExe" />
      <ComponentRef Id="SessionAgentExe" />
      <ComponentRef Id="Settings" />
      <!-- Start menu shortcut (per-user, so it only goes for the user who uninstalls). -->
      <ComponentRef Id="StartMenuShortcut" />
      <!-- Everything else: the runtime, libraries and native dependencies. -->
      <ComponentGroupRef Id="Payload" />
    </Feature>

    <!-- Welcome, license, folder, progress, finish. The license text is a placeholder that has to be replaced before
         this is handed to anybody (see License.rtf). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
