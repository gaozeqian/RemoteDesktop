<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <!-- WiX v5 on purpose: from v6 the Open Source Maintenance Fee applies to commercial use. v5 gets no more
         community fixes, so the installer is kept to standard features (no custom actions of our own beyond calling
         the server executable) to keep a later move to another tool cheap. Same choice as the client installer. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Architecture before version, like the client and host packages: one shape on all three platforms, and the
         shape release.yml and verify-packages look for. -->
    <OutputName>RemoteDesktop-Server-Windows-x64-$(ProductVersion)</OutputName>
    <OutputType>Package</OutputType>
    <!-- ICE61: same-version upgrades are deliberate. ICE63: the config-directory and settings-migration actions run
         between InstallInitialize and RemoveExistingProducts on purpose - they have to secure/copy the old product's
         settings before that action deletes them. Both are deferred; a failure stops the upgrade. -->
    <SuppressIces>ICE61;ICE63</SuppressIces>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Passed by Build-ServerInstaller.ps1: -p:ProductVersion=<four-part version> -p:SourceRoot=<publish folder>
         [-p:DefaultRendezvousUrl=...] -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <!-- What the signaling server listens on: the address baked into the installed Rendezvous\appsettings.json (read
         back from the publish output by Build-ServerInstaller.ps1) and the default of the RENDEZVOUSURL property. -->
    <DefaultRendezvousUrl Condition="'$(DefaultRendezvousUrl)' == ''">http://0.0.0.0:5080</DefaultRendezvousUrl>
    <DefineConstants>ProductVersion=$(ProductVersion);SourceRoot=$(SourceRoot);DefaultRendezvousUrl=$(DefaultRendezvousUrl);CustomActionsPath=$(CustomActionsPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- The WiX SDK already compiles every *.wxs in this folder (EnableDefaultCompileItems); listing them again
       would compile each one twice and the linker would see two packages. -->

  <Target Name="RequireGeneratedFiles" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Files.generated.wxs')"
           Text="Files.generated.wxs is missing. Run build\installer\windows\server\Build-ServerInstaller.ps1, which publishes the servers and generates the file list from the publish output." />
    <Error Condition="'$(SourceRoot)' == ''"
           Text="SourceRoot is not set. Run build\installer\windows\server\Build-ServerInstaller.ps1, or pass -p:SourceRoot=&lt;publish folder&gt;." />
  </Target>

</Project>
