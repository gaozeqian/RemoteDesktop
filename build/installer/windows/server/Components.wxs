<?xml version="1.0" encoding="utf-8"?>
<!--
  The components that need more than "a file": the four services, the inbound firewall rules that expose the network
  listeners, and their settings files. Everything else is generated from the publish output into Files.generated.wxs.

  The four program folders (Rendezvous, Relay, Ops, Gateway) are declared by that generated file, which mirrors the
  publish output; Build-ServerInstaller.ps1 tells the generator to name those directories RendezvousFolder,
  RelayFolder, OpsFolder and GatewayFolder, so the components here can be placed in them regardless of the order the
  publish output happens to be read in.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>
    <DirectoryRef Id="RendezvousFolder">

      <!-- The signaling server: device codes, presence, and the connect requests that put two peers in touch. -->
      <Component Id="RendezvousService" Guid="8b2c3d4e-5f6a-4b7c-9d0e-1f2a3b4c5d6e">
        <File Id="RendezvousExeFile" Source="$(var.SourceRoot)\Rendezvous\RemoteDesktop.Server.Rendezvous.exe" KeyPath="yes" />
        <ServiceInstall Id="RendezvousServiceInstall"
                        Name="RemoteDesktopRendezvous"
                        DisplayName="Remote Desktop Rendezvous"
                        Description="Connects Remote Desktop devices to each other (signaling)."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <!-- Started when installed, stopped on uninstall and on upgrades, so the executable is never in use. The same
             service name is what the program checks for when it decides whether it was started as a service or from a
             console (Program.cs), so the two have to keep agreeing. -->
        <ServiceControl Id="RendezvousServiceControl" Name="RemoteDesktopRendezvous" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- Restarted three times over, five seconds apart, with the count cleared after a day of running. A service
             that dies on a machine nobody is watching is a server that stays down until somebody notices, and the
             reset period is what keeps a server that crashed once — months ago, at a busy moment - from being counted
             with one that is crash-looping right now. -->
        <util:ServiceConfig ServiceName="RemoteDesktopRendezvous"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </Component>

      <!-- The shipped defaults. The live file is %ProgramData%\Remote Desktop Server\Rendezvous\appsettings.json,
           which the MSI does not own and therefore a major upgrade does not delete. This one is a normal component:
           an upgrade replaces it with the new defaults, which is exactly what it is for. -->
      <Component Id="RendezvousSettings" Guid="be5f6a7b-8c9d-4e0f-9a1b-4c5d6e7f8091">
        <File Id="RendezvousAppSettingsFile" Source="$(var.SourceRoot)\Rendezvous\appsettings.json" KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <DirectoryRef Id="RelayFolder">

      <!-- The relay: forwards UDP between two peers that could not reach each other directly, without reading what it
           forwards. Its port and the key it shares with the signaling server come from the same configuration step. -->
      <Component Id="RelayService" Guid="9c3d4e5f-6a7b-4c8d-9e0f-2a3b4c5d6e7f">
        <File Id="RelayExeFile" Source="$(var.SourceRoot)\Relay\RemoteDesktop.Server.Relay.exe" KeyPath="yes" />
        <ServiceInstall Id="RelayServiceInstall"
                        Name="RemoteDesktopRelay"
                        DisplayName="Remote Desktop Relay"
                        Description="Relays Remote Desktop connections between devices that cannot reach each other."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <ServiceControl Id="RelayServiceControl" Name="RemoteDesktopRelay" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- The same for the relay; see the note on the signaling server's failure actions above. -->
        <util:ServiceConfig ServiceName="RemoteDesktopRelay"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </Component>

      <!-- The other half of the shared key; see the comment on the signaling server's settings above. -->
      <Component Id="RelaySettings" Guid="cf6a7b8c-9d0e-4f1a-8b2c-5d6e7f809102">
        <File Id="RelayAppSettingsFile" Source="$(var.SourceRoot)\Relay\appsettings.json" KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <DirectoryRef Id="OpsFolder">

      <!-- The monitoring console. It is a server of its own — not a page inside the signaling server — because it
           aggregates across nodes, has its own sign-in, and must not be able to take signaling down with it. It binds
           to loopback by default, so it gets no firewall rule: exposing it is a reverse-proxy decision. -->
      <Component Id="OpsService" Guid="5e6f7a8b-9c0d-4e1f-8a2b-3c4d5e6f7a8b">
        <File Id="OpsExeFile" Source="$(var.SourceRoot)\Ops\RemoteDesktop.Server.Ops.exe" KeyPath="yes" />
        <ServiceInstall Id="OpsServiceInstall"
                        Name="RemoteDesktopOps"
                        DisplayName="Remote Desktop Ops Console"
                        Description="Monitoring and management console for the Remote Desktop servers."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <ServiceControl Id="OpsServiceControl" Name="RemoteDesktopOps" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- The console is optional, but once installed it should stay up: its own history (metrics, alerts, audit)
             is the only record of what happened, and a service that died on a machine nobody watches would leave a
             gap nobody notices until it matters. -->
        <util:ServiceConfig ServiceName="RemoteDesktopOps"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </Component>

      <!-- The console's own shipped defaults. The live file is under ProgramData, next to its database. -->
      <Component Id="OpsSettings" Guid="6f7a8b9c-0d1e-4f2a-9b3c-4d5e6f7a8b9c">
        <File Id="OpsAppSettingsFile" Source="$(var.SourceRoot)\Ops\appsettings.json" KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <DirectoryRef Id="GatewayFolder">

      <!-- The only listener the console needs from the network. It terminates TLS and forwards to Ops on loopback,
           so the console's own listener and application protections stay off the public interface. -->
      <Component Id="GatewayService" Guid="e28c9a10-4f5b-4c6d-9e7a-1b2c3d4e5f60">
        <File Id="GatewayExeFile" Source="$(var.SourceRoot)\Gateway\RemoteDesktop.Server.Gateway.exe" KeyPath="yes" />
        <ServiceInstall Id="GatewayServiceInstall"
                        Name="RemoteDesktopGateway"
                        DisplayName="Remote Desktop Ops Gateway"
                        Description="HTTPS reverse proxy for the Remote Desktop Ops console."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <ServiceControl Id="GatewayServiceControl" Name="RemoteDesktopGateway" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <util:ServiceConfig ServiceName="RemoteDesktopGateway"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </Component>

      <!-- The shipped defaults. The live file, generated certificate reference and proxy routes are written by the
           configuration step under ProgramData; this template only supplies the first-install defaults. -->
      <Component Id="GatewaySettings" Guid="f39dab21-506c-4d7e-af8b-2c3d4e5f6071">
        <File Id="GatewayAppSettingsFile" Source="$(var.SourceRoot)\Gateway\appsettings.json" KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">

      <!--
        The three inbound rules in a component of their own, keyed by a registry value rather than by one of the files
        or the services they are about. Two reasons, both of them from how Windows Installer works rather than from
        taste:

          * a firewall rule is a rule about a program, not a property of it: putting the rules inside the service
            components would tie "the rule was added" to "the service is installed", and a repair of one would touch
            the other;
          * NOFIREWALL=1 has to be able to leave them out while the services are still installed, which is what the
            condition on the component is for - a condition that is false installs none of what the component holds,
            and the same component is then simply absent from the machine (it is not an error for a component to be
            conditional, the way it is for a component that is missing from the package entirely).

        A failure to add a rule must not fail the installation (IgnoreFailure): without it the server still listens,
        it is simply unreachable from elsewhere until an administrator adds the rule by hand - which is exactly the
        case NOFIREWALL exists for.
      -->
      <Component Id="FirewallRules" Guid="ad4e5f6a-7b8c-4d9e-8f0a-3b4c5d6e7f80" Condition="NOFIREWALL&lt;&gt;&quot;1&quot;">
        <RegistryValue Root="HKLM" Key="Software\RemoteDesktop" Name="ServerFirewallRules" Type="integer" Value="1" KeyPath="yes" />

        <!-- Signaling: the WebSocket the clients and the devices keep open. The rule names the port as well as the
             program - "this program, on this port" is narrower than "this program, on anything it likes" - which
             means the rule is written for the default port. A deployment that moves a server (RENDEZVOUSURL, the
             relay's port) opens its own rule for the port it moved to; these three stay where the defaults are. -->
        <firewall:FirewallException Id="SignalingTcp"
                                    Name="Remote Desktop Rendezvous (TCP 5080)"
                                    Description="Incoming signaling connections from Remote Desktop clients and devices."
                                    Program="[#RendezvousExeFile]" Port="5080"
                                    Protocol="tcp" Profile="all" InterfaceType="all" Scope="any" IgnoreFailure="yes" />

        <!-- Address reflection: the UDP exchange that tells each peer how the other one appears from the outside, which
             is what lets them try a direct connection first. -->
        <firewall:FirewallException Id="SignalingReflectionUdp"
                                    Name="Remote Desktop Rendezvous address reflection (UDP 5081)"
                                    Description="Incoming address-reflection packets, used to find each peer's address as seen from the internet."
                                    Program="[#RendezvousExeFile]" Port="5081"
                                    Protocol="udp" Profile="all" InterfaceType="all" Scope="any" IgnoreFailure="yes" />

        <!-- The relay's UDP port: the traffic that could not go directly goes through here instead. -->
        <firewall:FirewallException Id="RelayUdp"
                                    Name="Remote Desktop Relay (UDP 5082)"
                                    Description="Relayed Remote Desktop traffic from devices that cannot reach each other directly."
                                    Program="[#RelayExeFile]" Port="5082"
                                    Protocol="udp" Profile="all" InterfaceType="all" Scope="any" IgnoreFailure="yes" />
      </Component>

      <!-- The HTTPS gateway's own rule, separate so NOFIREWALL can omit it without touching the three server rules.
           The port is the package default; a custom GATEWAYLISTEN needs an administrator-written rule. -->
      <Component Id="GatewayFirewallRule" Guid="a4ae8c32-617d-4e8f-b09c-3d4e5f607182" Condition="NOFIREWALL&lt;&gt;&quot;1&quot;">
        <RegistryValue Root="HKLM" Key="Software\RemoteDesktop" Name="ServerGatewayFirewallRule" Type="integer" Value="1" KeyPath="yes" />
        <firewall:FirewallException Id="GatewayHttps"
                                    Name="Remote Desktop Ops Gateway (TCP 5443)"
                                    Description="HTTPS access to the Remote Desktop Ops monitoring console."
                                    Program="[#GatewayExeFile]" Port="5443"
                                    Protocol="tcp" Profile="all" InterfaceType="all" Scope="any" IgnoreFailure="yes" />
      </Component>

    </DirectoryRef>

    <!--
      The machine-side steps are custom actions in this package's net48 DLL rather than command lines. There are four
      reasons, and each one is a defect the command-line version had:

        * The secrets (relay key, PostgreSQL connection string, TLS password) would otherwise be spelled out in the
          CustomAction target, which the MSI log records, and in the child's command line, which every local user can
          read. The DLL passes them to the child in its environment instead.
        * The installer database's string columns are 255 characters, and the configuration line had already run out of
          room before TLS, metrics, the configuration directory and the TLS host name were added.
        * The step needs to do more than one thing: run the configure-system step, then register the console's nodes,
          then leave a log that survives a rolled-back install.
        * A child process can be run with a real argument list and its output captured, so a failure is a sentence in
          the log rather than a 1722 from cmd.exe.

      The DLL still calls the server's own configure-system step; it does not reimplement what a setting means.
    -->
    <CustomAction Id="SetServerInstallDir"
                  Property="SERVERINSTALLDIR" Value="[INSTALLFOLDER]" Execute="immediate" />
    <CustomAction Id="SetServerConfigDir"
                  Property="SERVERCONFIGDIR" Value="[CONFIGFOLDER]" Execute="immediate" />
    <!-- Immediate, because both have to run before InstallInitialize: RemoveExistingProducts must be the very first
         action after InstallInitialize (MSI error 2613 otherwise), and the old files must still exist when the
         migration reads them. See the sequence comments. -->
    <CustomAction Id="SecureConfigDirectory"
                  BinaryRef="PageActions" DllEntry="SecureConfigDirectory"
                  Execute="immediate" Return="check" />
    <!-- The final half of the ACL change. Immediate actions are impersonated as the person installing, and a GUI
         install from a double-click can run them with a filtered token; restricting the directory there would stop the
         migration and the enumeration that used to follow. This deferred action runs as SYSTEM after the files exist,
         so the installer user's temporary access is removed once nobody needs it. -->
    <CustomAction Id="SetSecureConfigDirectoryFinalData"
                  Property="SecureConfigDirectoryFinal" Value="[SERVERCONFIGDATA]"
                  Execute="immediate" HideTarget="yes" />
    <CustomAction Id="SecureConfigDirectoryFinal"
                  BinaryRef="PageActions" DllEntry="SecureConfigDirectoryFinal"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="MigrateLiveSettings"
                  BinaryRef="PageActions" DllEntry="MigrateLiveSettings"
                  Execute="immediate" Return="check" />
    <CustomAction Id="SetDefaultTlsHostName"
                  BinaryRef="PageActions" DllEntry="SetDefaultTlsHostName"
                  Execute="immediate" Return="check" />

    <!-- A deferred managed action cannot read ordinary session properties; PrepareServerData (immediate) packs them into
         SERVERCONFIGDATA, and the three setters copy it into the property whose name is each deferred action's
         CustomActionData. HideTarget keeps the data out of the MSI log: it contains the relay key, the PostgreSQL
         connection string and the TLS password. -->
    <CustomAction Id="PrepareServerData"
                  BinaryRef="PageActions" DllEntry="PrepareServerData"
                  Execute="immediate" Return="check" />
    <CustomAction Id="SetConfigureServerData"
                  Property="ConfigureServer" Value="[SERVERCONFIGDATA]"
                  Execute="immediate" HideTarget="yes" />
    <CustomAction Id="SetSyncLocalNodesData"
                  Property="SyncLocalNodes" Value="[SERVERCONFIGDATA]"
                  Execute="immediate" HideTarget="yes" />
    <CustomAction Id="SetCleanupServerData"
                  Property="CleanupServer" Value="[SERVERCONFIGDATA]"
                  Execute="immediate" HideTarget="yes" />

    <CustomAction Id="ConfigureServer"
                  BinaryRef="PageActions" DllEntry="ConfigureServer"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="SyncLocalNodes"
                  BinaryRef="PageActions" DllEntry="SyncLocalNodes"
                  Execute="deferred" Impersonate="no" Return="ignore" HideTarget="yes" />
    <CustomAction Id="CleanupServer"
                  BinaryRef="PageActions" DllEntry="CleanupServer"
                  Execute="deferred" Impersonate="no" Return="ignore" HideTarget="yes" />

    <!-- The services are stopped by their ServiceControl rows, but an operator who started one of the servers from a
         console (or a deployment that runs them from a script) holds the executable open. Restart Manager refuses
         another user's session; taskkill does not. Reports an error when there is nothing to kill, which is ignored. -->
    <CustomAction Id="StopLeftoverProcesses"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c taskkill /f /im RemoteDesktop.Server.Rendezvous.exe /im RemoteDesktop.Server.Relay.exe /im RemoteDesktop.Server.Ops.exe /im RemoteDesktop.Server.Gateway.exe"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Before validation, because that is when Windows decides whether a restart will be needed. -->
      <Custom Action="StopLeftoverProcesses" Before="InstallValidate" />
      <!--
        The live settings are kept in %ProgramData%\Remote Desktop Server, outside the MSI's file table. The first
        upgrade from a package that kept them under Program Files copies them across *before* RemoveExistingProducts
        deletes the old product's files; every later upgrade finds the destination there and leaves it alone.
        SecureConfigDirectory runs first so the migrated files land in a directory only SYSTEM, Administrators and the
        installing user can read (they contain the relay key and, with PostgreSQL, its password). The installing user is
        there because a GUI install's immediate actions can run with a filtered token; SecureConfigDirectoryFinal,
        scheduled after the files are installed and running as SYSTEM, removes that access again.

        Both run in the immediate sequence, before InstallInitialize, because RemoveExistingProducts has to be the
        first action after InstallInitialize (otherwise Windows Installer fails with error 2613) and the old files are
        gone by the time a deferred action could run. The package is per-machine and elevated, so writing ProgramData
        here is allowed.
      -->
      <!-- SetServerConfigDir also runs on uninstall: CleanupServer needs the configuration directory, and a deferred
           action cannot read it from the session. The other values only matter when the machine is being configured,
           but PrepareServerData packs them in every case (empty ones stay empty). -->
      <Custom Action="SetServerInstallDir"
              Before="PrepareServerData"
              Condition="NOT REMOVE" />
      <Custom Action="SetServerConfigDir"
              Before="PrepareServerData" />
      <Custom Action="PrepareServerData"
              Before="SetConfigureServerData" />
      <Custom Action="SetConfigureServerData"
              Before="SetSyncLocalNodesData" />
      <Custom Action="SetSyncLocalNodesData"
              Before="SetCleanupServerData" />
      <Custom Action="SetCleanupServerData"
              Before="SecureConfigDirectory" />
      <Custom Action="SecureConfigDirectory"
              Before="MigrateLiveSettings"
              Condition="NOT REMOVE" />
      <Custom Action="MigrateLiveSettings"
              Before="InstallInitialize"
              Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="SetSecureConfigDirectoryFinalData"
              Before="SecureConfigDirectoryFinal"
              Condition="NOT REMOVE" />
      <Custom Action="SecureConfigDirectoryFinal"
              After="InstallFiles"
              Condition="NOT REMOVE" />

      <!-- First install only. The properties are first-install inputs; an upgrade preserves the live files, matching
           how the Linux and macOS packages ask for their settings only on a first install. -->
      <Custom Action="SetDefaultTlsHostName"
              Before="ConfigureServer"
              Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED AND NOT Installed" />
      <Custom Action="ConfigureServer"
              After="InstallFiles"
              Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED AND NOT Installed" />

      <!-- An upgrade keeps the console's node table but may change the scheme (http <-> https); the two rows the
           installer created are updated, an operator's own rows and deleted rows are left alone. -->
      <Custom Action="SyncLocalNodes"
              After="InstallFiles"
              Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED" />

      <!-- Uninstall: the services are already stopped by their ServiceControl rows. Data and the generated certificate
           go only when the operator asked for it. -->
      <Custom Action="CleanupServer"
              Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVEDATA=&quot;1&quot;" />
    </InstallExecuteSequence>

    <!-- ==========================================================================================================
         The one page of this wizard that asks anything.

         Everything these controls write is a property the deferred action above already reads, so the page is the
         only new thing: without it a double-click install takes every default, and the defaults are "no database"
         and "plain http" — the two settings whose consequences are worst (device codes that change on every restart,
         and device codes and relay tickets readable by anyone on the way) and whose warnings end up in a log file
         nobody installing by double-click ever opens.

         It goes through WixUI_InstallDir's sequence rather than replacing it: the standard dialogs stay, this one is
         wired in after the install folder has been chosen.
         ========================================================================================================== -->
    <!-- ==========================================================================================================
         The start menu entry: "how do I change this", pointed at the page that answers it.

         Keyed by a registry value under HKCU because a shortcut is per-user data even when the program is installed
         for everybody (ICE43/ICE57) — the same shape the client package uses for its own shortcut.
         ========================================================================================================== -->
    <DirectoryRef Id="ServerShortcutFolder">
      <Component Id="ServerShortcut" Guid="d17b8c9d-0e1f-4a2b-9c3d-4e5f6a7b8c9d">
        <Shortcut Id="HowToConfigureLink" Name="服务器配置说明"
                  Description="How to change the database, relay address and TLS settings of these servers"
                  Target="[INSTALLFOLDER]how-to-configure.txt" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RemoteDesktop\Server" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <!-- Windows Installer only removes folders it is told about. -->
        <RemoveFolder Id="RemoveServerShortcutFolder" Directory="ServerShortcutFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- The custom actions the settings page calls, packed into one DLL by the build (net48: msiexec hosts the .NET
         Framework runtime, so this is the only kind of assembly it can load). They are immediate actions, which is the
         whole point — they run inside msiexec, where the properties the page wrote are readable and a property they
         set is what the page shows next. -->
    <Binary Id="PageActions" SourceFile="$(var.CustomActionsPath)" />
    <CustomAction Id="BrowseForCertificate" BinaryRef="PageActions" DllEntry="BrowseForCertificate" Execute="immediate" Return="check" />
    <CustomAction Id="PrefillSettings" BinaryRef="PageActions" DllEntry="PrefillSettings" Execute="immediate" Return="check" />
    <CustomAction Id="NormalizeSettings" BinaryRef="PageActions" DllEntry="NormalizeSettings" Execute="immediate" Return="check" />

    <UI>

    <Dialog Id="ServerSettingsDlg" Width="370" Height="400" Title="[ProductName] 安装向导">
      <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}服务器设置" />
      <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="以下都可以留空，装完也能改（见安装目录下的 Set-ServerConfiguration.cmd）。" />
      <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
      <Control Id="BottomLine" Type="Line" X="0" Y="368" Width="370" Height="0" />

      <!-- The database. This box is for the advanced case — a PostgreSQL server that already exists — and it arrives
           empty on purpose: an empty box means "decide for this machine", which now starts a SQLite database in
           %ProgramData% and keeps every device code across restarts. It used to arrive holding a template pointing at
           a PostgreSQL on this machine, which only made sense while the alternative was no database at all. -->
      <Control Id="PostgresLabel" Type="Text" X="20" Y="52" Width="330" Height="12" NoPrefix="yes" Text="PostgreSQL 连接串（留空 = 用本机 SQLite，自动创建）" />
      <Control Id="PostgresEdit" Type="Edit" X="20" Y="64" Width="330" Height="16" Property="POSTGRESCONNECTIONSTRING" />
      <Control Id="PostgresNote" Type="Text" X="20" Y="82" Width="330" Height="12" NoPrefix="yes" Text="填了就用 PostgreSQL（库要先建好，只建表）。留空则用 SQLite：文件在本机数据目录，重启后设备码不变。" />

      <!-- Where clients are told to reach the relay. "auto" picks this machine's first non-loopback address, which on
           a machine with a VPN is the VPN's. -->
      <Control Id="RelayLabel" Type="Text" X="20" Y="104" Width="330" Height="12" NoPrefix="yes" Text="中继公网地址（客户端用它找中继）" />
      <Control Id="RelayEdit" Type="Edit" X="20" Y="116" Width="330" Height="16" Property="RELAYPUBLICENDPOINT" Text="[RELAYPUBLICENDPOINT]" />
      <Control Id="RelayNote" Type="Text" X="20" Y="134" Width="330" Height="24" NoPrefix="yes" Text="auto = 自动选本机地址，装了 VPN 或有虚拟网卡时会选错。也可以填域名，但安装时会解析成 IP 写死。" />

      <!-- TLS: three choices, and the middle one is why this page is worth having. -->
      <Control Id="TlsLabel" Type="Text" X="20" Y="166" Width="330" Height="12" NoPrefix="yes" Text="信令是否走 TLS" />
      <!-- Flat, not nested: in this schema the group is a control of its own and each button is a sibling that names
           the group's property. -->
      <Control Id="TlsChoice" Type="RadioButtonGroup" X="20" Y="178" Width="330" Height="46" Property="TLSCHOICE">
        <RadioButtonGroup Property="TLSCHOICE">
          <RadioButton Value="none" X="4" Y="2" Width="322" Height="13" Text="不启用：明文 http，设备代码与中继票据在途中可被读取" />
          <RadioButton Value="generate" X="4" Y="17" Width="322" Height="13" Text="自动生成一张自签名证书并启用 https（推荐）" />
          <RadioButton Value="file" X="4" Y="32" Width="322" Height="13" Text="使用已有的证书文件" />
        </RadioButtonGroup>
      </Control>

      <!-- The names the certificate has to answer. It only matters when the certificate is generated; a file the
           operator supplies already has its own SANs. Empty means the machine name. -->
      <Control Id="TlsHostLabel" Type="Text" X="34" Y="230" Width="312" Height="12" NoPrefix="yes" Text="证书域名（客户端拨的 DNS 名或 IP，逗号分隔；留空用本机名）" />
      <Control Id="TlsHostEdit" Type="Edit" X="34" Y="242" Width="316" Height="16" Property="TLSCERTIFICATEHOSTNAME" Text="[TLSCERTIFICATEHOSTNAME]" />

      <!-- Two lines, one field each: on one line the password box came out about thirty pixels wide, which is not a
           field anybody can type a password into. -->
      <Control Id="TlsPathLabel" Type="Text" X="34" Y="264" Width="312" Height="12" NoPrefix="yes" Text="证书文件路径（.pfx）" />
      <!-- Bound to its own property, and not to the one the install reads, so that nothing the install needs can show
           up in a box labelled "path". TLSCERTIFICATEPATH holds a word rather than a path whenever TLS is off or the
           certificate is to be generated, and this box used to display it: choosing "generate" and pressing Next left
           the word generate sitting in the path field, which is at best confusing and at worst looks like a filename.

           It arrives holding a single space. That is not decoration: a control is only editable while the property it
           is bound to is defined, and a property with no value never reaches the property table, so an empty one
           would leave this box greyed. A space is invisible in a text box, and the server reads a value of nothing but
           spaces as "no certificate" - it already did, for the properties it reads. -->
      <Control Id="TlsPathEdit" Type="Edit" X="34" Y="276" Width="240" Height="16" Property="TLSCERTIFICATEFILE" />
      <!-- Windows Installer's own browse dialog picks folders, not files, so this button runs our own action, which
           puts the chosen path into the property the page shows.

           Writing the property is not enough on its own. The edit box above was filled in from the property when the
           dialog opened and never looks at it again, so the path would be stored while the box still showed the old
           text. There is no event that pushes a property back into a control: Reset looks like one and is the
           opposite, restoring the control's original text and writing *that* into the property, which silently threw
           the chosen path away — the log showed the path being set and then replaced by "auto" 27 milliseconds later.

           What does refresh a dialog is navigating to it: the installer builds a dialog each time it is entered, and
           its controls then read their [Property] text afresh. Showing a dialog on top of this one is not enough —
           the installer's log showed the page below never being built again when a spawned dialog closed, which is
           how the first attempt at this failed. So choosing a file moves forward to a page that shows it, and coming
           back from there is what makes this page correct.

           That page cannot be this one. Pointing the transition at ServerSettingsDlg would save the extra step, and
           was tried: the installer refuses with "Error 2856: Creating a second copy of the dialog ServerSettingsDlg"
           and the wizard dies on the spot, so the step is not a shortcoming of this button but the shortest way round
           a rule. It is also why none of the dialogs in WiX's own interface ever names itself. -->
      <Control Id="TlsBrowseButton" Type="PushButton" X="278" Y="276" Width="72" Height="16" Text="浏览…">
        <Publish Event="DoAction" Value="BrowseForCertificate" Order="1" />
        <!-- Only when a file was actually chosen: nothing changed if the file dialog was cancelled, so there is nothing
             to show and no reason to interrupt. -->
        <Publish Event="NewDialog" Value="CertificateChosenDlg" Order="2" Condition="TLSCERTIFICATECHOSEN = &quot;1&quot;" />
      </Control>
      <Control Id="TlsPasswordLabel" Type="Text" X="34" Y="298" Width="312" Height="12" NoPrefix="yes" Text="证书口令（没有口令就留空）" />
      <!-- A plain box, showing what is typed. It was a password box, which draws a dot per character, and that made the
           field impossible to leave looking empty: the property has to hold something for the box to be usable at all,
           so it held a word, so it showed four dots, and the page appeared to have been filled in already. Now it holds
           a space, which reads as nothing, and the value is trimmed on the way out so that typing a real password after
           it still works. The cost is that the password is on screen, and in the installer's log like any other
           command-line value — which is why a certificate protected by where the file lives is still the better one. -->
      <Control Id="TlsPasswordEdit" Type="Edit" X="34" Y="310" Width="316" Height="16" Property="TLSCERTIFICATEPASSWORD" />
      <Control Id="TlsNote" Type="Text" X="20" Y="332" Width="330" Height="24" NoPrefix="yes" Text="自动生成的证书放在本机证书存储，公钥导出到安装目录 tls\signaling.cer —— 客户端要信任它，否则会拒绝连接；证书里的域名要覆盖客户端拨的名字。" />

      <Control Id="Back" Type="PushButton" X="180" Y="377" Width="56" Height="17" Text="!(loc.WixUIBack)">
        <Publish Event="NewDialog" Value="InstallDirDlg" />
      </Control>
      <Control Id="Next" Type="PushButton" X="236" Y="377" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
        <!-- What is in the boxes is tidied up on the way out — the password trimmed, and any box left empty put back
             to the space the page needs in order to be able to show it. See NormalizeSettings. -->
        <Publish Event="DoAction" Value="NormalizeSettings" Order="1" Condition="1" />

        <!-- "Use an existing certificate file" with no file must not silently fall through to plain http. The dialog
             is shown instead of the mapping/transition below, whose conditions then stay false and keep the wizard on
             this page until the user picks a file or chooses another TLS option. -->
        <Publish Event="SpawnDialog" Value="CertificateMissingDlg" Order="2"
                 Condition="TLSCHOICE = &quot;file&quot; AND TLSCERTIFICATEFILE = &quot; &quot;" />

        <!-- The radio group and what the install acts on are two different properties: the page collects a choice in
             TLSCHOICE and the file in TLSCERTIFICATEFILE, and the deferred action reads TLSCERTIFICATEPATH, which is
             either a file or the word the server reads as "no certificate" or "make one". These lines are the
             mapping, and they have to be written as "[Property]" — the event column is where a property to set is
             named, and there is no event called SetProperty. Written that way the installer reports "Error 2812: The
             event SetProperty is not recognized" and dies on this button, but only when one of these conditions is
             met, so it stayed hidden while the page was being used with a certificate file chosen. -->
        <Publish Event="[TLSCERTIFICATEPATH]" Value="auto" Order="3" Condition="TLSCHOICE = &quot;none&quot;" />
        <Publish Event="[TLSCERTIFICATEPATH]" Value="generate" Order="4" Condition="TLSCHOICE = &quot;generate&quot;" />
        <Publish Event="[TLSCERTIFICATEPATH]" Value="[TLSCERTIFICATEFILE]" Order="5"
                 Condition="TLSCHOICE = &quot;file&quot; AND TLSCERTIFICATEFILE &lt;&gt; &quot; &quot;" />
        <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="6"
                 Condition="TLSCHOICE &lt;&gt; &quot;file&quot; OR TLSCERTIFICATEFILE &lt;&gt; &quot; &quot;" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="377" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- ==========================================================================================================
         Shown after a certificate file has been picked, and shown for two reasons.

         One is that a path is worth seeing before it is relied on: the settings page behind cannot update its own
         text box while it is on screen (see the note on the browse button), so this is where the choice is confirmed
         to the person who made it. The other is that it is the way back — returning to the settings page builds it
         again, which is the only thing that makes its controls re-read the property.

         It holds nothing to type into, so it cannot fail: one button, and the file that will be used.
         ========================================================================================================== -->
    <Dialog Id="CertificateChosenDlg" Width="370" Height="120" Title="[ProductName] 安装向导">
      <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}已选择证书文件" />
      <Control Id="Description" Type="Text" X="25" Y="26" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="安装后将用这个文件对外提供 https。" />
      <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
      <Control Id="BottomLine" Type="Line" X="0" Y="84" Width="370" Height="0" />
      <!-- Two lines tall: a path is easily longer than the dialog is wide, and a path cut off mid-way is worse than
           no confirmation at all, because it looks like a different file. It shows TLSCERTIFICATEFILE, which Browse
           has just set; TLSCERTIFICATEPATH is only mapped from it when Next is pressed. -->
      <Control Id="ChosenPath" Type="Text" X="25" Y="52" Width="330" Height="26" Transparent="yes" NoPrefix="yes" Text="[TLSCERTIFICATEFILE]" />
      <Control Id="OK" Type="PushButton" X="294" Y="92" Width="56" Height="17" Default="yes" Text="!(loc.WixUIOK)">
        <Publish Event="NewDialog" Value="ServerSettingsDlg" />
      </Control>
    </Dialog>

    <!-- Shown when "use an existing certificate file" was chosen and no file was. Without it the mapping would send
         the space the box holds as the path, the server would read it as "no certificate", and the installation
         would quietly serve plain http. -->
    <Dialog Id="CertificateMissingDlg" Width="370" Height="120" Title="[ProductName] 安装向导">
      <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}还没有选择证书" />
      <Control Id="Description" Type="Text" X="25" Y="26" Width="330" Height="30" Transparent="yes" NoPrefix="yes" Text="已选择“使用已有的证书文件”，但没有指定文件。请用“浏览…”选择，或改回其他 TLS 选项。" />
      <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
      <Control Id="BottomLine" Type="Line" X="0" Y="84" Width="370" Height="0" />
      <Control Id="OK" Type="PushButton" X="294" Y="92" Width="56" Height="17" Default="yes" Text="!(loc.WixUIOK)">
        <Publish Event="NewDialog" Value="ServerSettingsDlg" />
      </Control>
    </Dialog>

      <!-- Into the wizard, after the folder has been chosen. The dialog set's own transition to VerifyReadyDlg stays
           where it is, with a lower ordering: the last matching transition is the one that takes effect, which is why
           these carry a higher Order than the built-in ones (the dialog set uses 1 and 4). -->
      <!-- Filling the address boxes in happens here rather than inside the page, because a control's text is read from
           its property once, when the dialog is built — a value set after that is one the page never shows. This runs
           immediately before the transition, in the same batch of events. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="PrefillSettings" Order="5" Condition="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServerSettingsDlg" Order="6" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerSettingsDlg" Order="5" Condition="1" />
    </UI>
  </Fragment>

</Wix>
