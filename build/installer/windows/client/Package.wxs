<?xml version="1.0" encoding="utf-8"?>
<!--
  One installer per role. The default package installs the client, the background service and the session agent into
  one folder: the service is what makes this computer reachable, and the client is both the window of this computer and
  the controller of others. Built with -HostOnly it is the controlled end's package instead — the same service and
  agent, without the client — with its own product name and UpgradeCode so the two upgrade independently.
  Everything else (files, dialogs) lives in Components.wxs and Files.generated.wxs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Codepage 936 (GBK): the host package's unattended-settings page has Chinese labels, and MSI strings are stored
       in the database codepage. The client package shares this file, so it gets the same codepage; its WixUI strings
       are ASCII and unaffected. -->
  <Package Name="$(var.ProductName)" Manufacturer="Remote Desktop" Version="$(var.ProductVersion)"
           UpgradeCode="$(var.ProductUpgradeCode)"
           Scope="perMachine" Compressed="yes" InstallerVersion="500"
           Codepage="936">

    <!-- The custom pages and the licence are Chinese; the standard WixUI buttons (Back/Next/Cancel) come from the
         extension's default English localization. Say that rather than "Chinese UI", which would be wrong in a
         procurement checklist. Add a WixUI .wxl and the languages here when the standard pages are localized. -->
    <?ifdef var.HostOnly ?>
    <SummaryInformation Description="Remote desktop, controlled end: the background service and the session agent. Chinese pages." />
    <?else?>
    <SummaryInformation Description="Remote desktop: control, file transfer, terminal and camera. Chinese pages." />
    <?endif?>

    <!-- The product icon in Settings > Apps and on the Start menu shortcut. The same source icon as the exe and the
         window; without ARPPRODUCTICON Windows Installer shows its generic package icon there. -->
    <Icon Id="AppIcon" SourceFile="..\..\..\..\src\Hosts\RemoteDesktop.Client\Assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Same-version installs upgrade in place, which is what rebuilding the same version while testing needs. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of this Remote Desktop package is already installed." />

    <!--
      The two roles share the service name RemoteDesktopHost, so they cannot be installed side by side: the second
      installer would add a second service with the same name, and the machine would end up with one product's files
      and the other's registration. Refusing is better than half-working, and the message says what to do.

      Each package names the *other* one's UpgradeCode here, so this is also what makes "install one, then the other"
      a clear error rather than a silent overwrite.
    -->
    <?ifdef var.HostOnly ?>
    <Upgrade Id="6f3c1a26-9b57-4d0e-8f2a-5c7b1e4d9a30">
      <UpgradeVersion Minimum="0.0.0" Maximum="255.255.65535" IncludeMinimum="yes" IncludeMaximum="no"
                      Property="CLIENTPACKAGEINSTALLED" OnlyDetect="yes" />
    </Upgrade>
    <Launch Condition="NOT CLIENTPACKAGEINSTALLED"
            Message="This machine already has the client package, which also installs the controlled end. Uninstall it first if you want the controlled-end-only package here." />
    <?else?>
    <Upgrade Id="3d9e7b41-6c2a-4f18-8b57-2e4c1a9d6f03">
      <UpgradeVersion Minimum="0.0.0" Maximum="255.255.65535" IncludeMinimum="yes" IncludeMaximum="no"
                      Property="HOSTPACKAGEINSTALLED" OnlyDetect="yes" />
    </Upgrade>
    <Launch Condition="NOT HOSTPACKAGEINSTALLED"
            Message="This machine already has the controlled-end-only package. The client package also installs the controlled end; uninstall the host package first if you want the client here." />
    <?endif?>
    <MediaTemplate EmbedCab="yes" />

    <!-- The server this installation talks to. The default is the address baked in when the installer was built
         (Build-ClientInstaller.ps1 -RendezvousUri); the connection page shows it and lets the operator change it, and
         a silent install can give it as:
         msiexec /i <msi> RENDEZVOUSURI=ws://rd.example.com:5080/ws SERVERCERTIFICATEPATH=C:\certs\signaling.cer
         It has a value (rather than none) on purpose: a property without one is left out of the property table
         altogether, and the deferred custom action that writes it into appsettings.json would find nothing.
         Secure so that the deferred action receives it. -->
    <Property Id="RENDEZVOUSURI" Value="$(var.DefaultRendezvousUri)" Secure="yes" />

    <!-- The build/command-line default is kept separately so the connection page's prefill can tell "still the package
         default" from "the operator passed an address on the command line". On an upgrade the live address is the
         default shown in the page; an explicit command-line address still wins. -->
    <Property Id="DEFAULT_RENDEZVOUSURI" Value="$(var.DefaultRendezvousUri)" />

    <!-- The certificate source chosen/typed on the connection page. A space keeps the edit control editable; the
         execute action exports only its public half to ProgramData, so a PEM/PFX that also carries a private key never
         puts that key on the machine. -->
    <Property Id="SERVERCERTIFICATEPATH" Value=" " Secure="yes" />
    <!-- The public certificate file the configure-system step pins in the machine settings. -->
    <Property Id="RENDEZVOUSCERTIFICATEPATH" Value=" " Secure="yes" />
    <!-- Set when the connection page is left with Next. On an upgrade the execute sequence applies the page's values
         only then; a silent upgrade leaves the live address and certificate pin untouched. -->
    <Property Id="CONNECTIONEDITED" Value="0" />
    <!-- A space means "no error"; validation puts its message here and the page shows it instead of moving on. -->
    <Property Id="CONNECTIONERROR" Value=" " />
    <Property Id="SERVERCERTIFICATECHOSEN" Value="0" />

    <!-- Uninstalling keeps the device identity and logs (a reinstall then keeps the same device code) unless the person
         asks for them to go: msiexec /x ... REMOVEDATA=1 -->
    <Property Id="REMOVEDATA" Value="0" Secure="yes" />

    <?ifdef var.HostOnly ?>
    <!--
      The fixed password for unattended access. It has a single space rather than no value because a control is only
      editable while its property is defined (the same reason the server's certificate box arrives holding a space);
      the setup command trims it, so a space means "leave what is there alone". Secure so the deferred action receives
      it, and Hidden so it does not end up in the installer log. MsiHiddenProperties itself is a special MSI property
      and may not be authored directly (WiX 5 errors WIX0070); Hidden is the supported way to add to it.

      The host package has no window, so this page is the only place a fresh host can be given a password without a
      command line. The value is passed to the service executable as an argument; a double quote in it would break the
      command line, and the page says so.
    -->
    <Property Id="FIXEDPASSWORD" Value=" " Secure="yes" Hidden="yes" />
    <Property Id="CLEARFIXEDPASSWORD" Value="0" Secure="yes" />
    <!-- Written by WriteFixedPasswordFile (immediate) and read by the deferred SetFixedPassword/Delete actions. The
         password itself travels in this file, not in the host process's command line. No Value: the action sets it,
         and the empty Property row is what puts it in the secure list. -->
    <Property Id="FIXEDPASSWORDFILE" Value=" " Secure="yes" />
    <?endif?>

    <!-- A deferred action cannot read a directory property unless it is secure or carried in CustomActionData; the
         migration needs the install folder after the elevation boundary. SetClientInstallDir copies it in the
         immediate pass. It is outside the HostOnly block because the client package migrates too. -->
    <Property Id="CLIENTINSTALLFOLDER" Value=" " Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RemoteDesktop" />
    </StandardDirectory>
    <?ifndef var.HostOnly ?>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="Remote Desktop" />
    </StandardDirectory>
    <?endif?>

    <Feature Id="Main" Title="$(var.ProductName)" Level="1" AllowAbsent="no">
      <!-- The window of this computer and the controller for others. Not in the host-only package. -->
      <?ifndef var.HostOnly ?>
      <ComponentRef Id="ClientExe" />
      <?endif?>
      <!-- The service that accepts connections, plus the agent that does the work inside the session. -->
      <ComponentRef Id="HostServiceExe" />
      <ComponentRef Id="SessionAgentExe" />
      <ComponentRef Id="Settings" />
      <!-- Start menu shortcut (per-user, so it only goes for the user who uninstalls). -->
      <?ifndef var.HostOnly ?>
      <ComponentRef Id="StartMenuShortcut" />
      <?endif?>
      <!-- Only in a build that signed with a self-signed certificate (see Components.wxs). -->
      <?ifdef var.TrustedRootCertificate ?>
      <ComponentRef Id="TrustedRootCert" />
      <?endif?>
      <!-- Only in a build that was given the signaling server's certificate (see Components.wxs). -->
      <?ifdef var.TrustedServerCertificate ?>
      <ComponentRef Id="TrustedServerCert" />
      <?endif?>
      <!-- Everything else: the runtime, libraries and native dependencies. -->
      <ComponentGroupRef Id="Payload" />
    </Feature>

    <!--
      Processes left over from an earlier version hold their own files open, and then the installer can neither replace
      those files nor run them: a real upgrade failed exactly here, with error 1721 on the custom action that runs the
      service executable, because a session agent started by the client (standalone mode) was still alive. Windows' own
      Restart Manager cannot help either: it refuses to restart an application that belongs to another user's session
      ("Application SID does not match Conductor SID"), so the installer closes them itself.
    -->
    <util:CloseApplication Id="CloseAgent" Target="RemoteDesktop.SessionAgent.exe"
                           CloseMessage="no" RebootPrompt="no" TerminateProcess="1" Timeout="20" />
    <?ifndef var.HostOnly ?>
    <util:CloseApplication Id="CloseClient" Target="RemoteDesktop.Client.exe"
                           CloseMessage="no" RebootPrompt="no" TerminateProcess="1" Timeout="20" />
    <?endif?>

    <!-- Welcome, license, folder, progress, finish. The license text is the repository's LICENSE, shared with the
         server package, and the RTF the dialog needs is generated from it by New-LicenseRtf.ps1 while building, so the
         two cannot drift apart. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="..\..\License.rtf" />

  </Package>
</Wix>
