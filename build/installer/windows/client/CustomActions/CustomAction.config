<?xml version="1.0" encoding="utf-8"?>
<!--
  Tells SfxCA's native host which runtime to start. It has to be packed into the custom action DLL because that host
  reads it out of the package it extracts itself into. Without it the host asks for the .NET 2.0 CLR, which no
  supported Windows has, and gives up with 0x80131700 before any of our code runs.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
