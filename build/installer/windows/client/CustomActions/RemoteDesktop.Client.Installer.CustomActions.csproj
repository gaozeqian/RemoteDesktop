<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The client/host package's installer plumbing. Net48 because Windows Installer hosts the .NET Framework runtime
    inside msiexec; Platform=x64 because the DTF targets pick SfxCA's native host stub from $(Platform), and this
    package's msiexec is 64-bit. Both reasons are the same as the server package's project.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Spelled out rather than left to the SDK, which adds the same reference implicitly only where no .NET Framework
      targeting pack is installed. On Windows it therefore never appeared, so it was missing from packages.lock.json,
      while on the Linux and macOS runners the SDK added it and a locked-mode restore failed with NU1004 for a project
      nobody had changed. Referencing it here makes the package graph the same everywhere, and the build now compiles
      against the package's reference assemblies on Windows too instead of whatever targeting pack the machine has.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="5.0.2" />
  </ItemGroup>

  <!-- Packed into the DLL so the host starts the CLR the package needs. Without it the action fails in two
       milliseconds with no log line of its own; see the file. -->
  <ItemGroup>
    <Content Include="CustomAction.config" />
  </ItemGroup>

</Project>
