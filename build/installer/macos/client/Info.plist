<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle is not cosmetic on macOS: TCC (screen recording, accessibility, camera) and the keychain both key their
  decisions off the code-signing identity *of a bundle*, and since macOS 26 a bare CLI executable does not even appear
  in the Privacy & Security list. So the client has to run from an .app to be grantable at all.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>RemoteDesktop.Client</string>
	<key>CFBundleIdentifier</key>
	<string>com.remotedesktop.client</string>
	<!-- The Dock/Finder icon. This is the only icon macOS shows for an application: a macOS window has no title-bar
	     icon, so the bundle is the whole story. The .icns is generated from Assets/icon-*.png by make-icns.sh. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Remote Desktop</string>
	<key>CFBundleDisplayName</key>
	<string>Remote Desktop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<!-- Same value as the marketing version on purpose: this app ships as a Developer ID .pkg, not through the App
	     Store, so Apple's monotonically increasing build-number rule does not apply. If an App Store or Sparkle
	     update feed is ever added, this has to become a build number of its own. -->
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Must match the highest `minos` of the bundled dylibs, otherwise dyld refuses to load them. The Homebrew
	     bottles of libmsquic/openssl@4 are built for macOS 26, so this tracks that (see docs/ports/README.md,
	     "最低系统版本是 macOS 26"). -->
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Tells AppKit this is a real GUI application: without it the process gets no menu bar and no Dock entry. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

	<!--
	  Usage descriptions. macOS shows these in the permission prompt; a missing key is not a warning, it is a crash the
	  moment the framework is touched. Screen recording has no key of its own — ScreenCaptureKit asks for itself.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Remote Desktop 需要访问摄像头，才能把本机摄像头画面转发给远端会话。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Remote Desktop 需要访问麦克风，才能把本机声音转发给远端会话。</string>
	<!-- macOS 15 and later gate access to addresses on the local network (10/8, 172.16/12, 192.168/16): without this
	     key the connection is refused with no prompt and no entry in System Settings. A rendezvous server or a peer on
	     the same LAN is the normal self-hosted deployment, so this is not optional. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Remote Desktop 需要访问局域网，才能连接同一网络内的信令服务器与其他设备。</string>

	<key>NSDesktopFolderUsageDescription</key>
	<string>Remote Desktop 需要访问桌面文件夹，才能在被控时传输其中的文件。</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Remote Desktop 需要访问文稿文件夹，才能在被控时传输其中的文件。</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Remote Desktop 需要访问下载文件夹，才能在被控时传输其中的文件。</string>
</dict>
</plist>
