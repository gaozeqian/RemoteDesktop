# Copy this file to .env (which is ignored by git) and replace every placeholder.
#
#   cp .env.example .env
#
# Generate the secrets with:
#
#   POSTGRES_PASSWORD       openssl rand -base64 24
#   RELAY_SHARED_KEY        openssl rand -base64 48
#   NODE_TOKEN              openssl rand -base64 32
#   OPS_INGEST_KEY          openssl rand -base64 32
POSTGRES_PASSWORD=change-me
RELAY_SHARED_KEY=change-me
RELAY_PUBLIC_ENDPOINT=203.0.113.10:5082
NODE_TOKEN=change-me

# Optional: the public hostname for docker-compose.tls.yml (Caddy obtains the certificate for it).
# RENDEZVOUS_DOMAIN=rd.example.com

# Optional: the network or address of the reverse proxy whose X-Forwarded-For is believed.
# Defaults to 172.16.0.0/12, which contains Docker's default bridge networks.
# RENDEZVOUS_TRUSTED_PROXIES=172.16.0.0/12

# Optional: the HMAC key nodes and the console share in docker-compose.ops.yml.
# OPS_INGEST_KEY=change-me
