# Copy this file to .env (which is ignored by git) and replace every placeholder.
#
#   cp .env.example .env
#
# Generate the secrets with:
#
#   POSTGRES_PASSWORD       openssl rand -base64 24
#   RELAY_SHARED_KEY        openssl rand -base64 48
#   NODE_TOKEN              openssl rand -base64 32
#   OPS_INGEST_KEY          openssl rand -base64 32
POSTGRES_PASSWORD=change-me
RELAY_SHARED_KEY=change-me
RELAY_PUBLIC_ENDPOINT=203.0.113.10:5082
NODE_TOKEN=change-me

# Optional: the public hostname for docker-compose.tls.yml (Caddy obtains the certificate for it).
# RENDEZVOUS_DOMAIN=rd.example.com

# Optional: the network or address of the reverse proxy whose X-Forwarded-For is believed.
# Defaults to 172.16.0.0/12, which contains Docker's default bridge networks.
# RENDEZVOUS_TRUSTED_PROXIES=172.16.0.0/12

# Optional: the HMAC key nodes and the console share in docker-compose.ops.yml.
# OPS_INGEST_KEY=change-me

# Required when docker-compose.ops.yml is used: the Docker host IPv4 address administrators open in a browser.
# The gateway generates a self-signed certificate with this address as an IP SAN. Use the address they actually type,
# including a NAT address when one is in front of the host.
# OPS_GATEWAY_IP=192.168.1.10

# Optional: comma-separated DNS names to add to the gateway certificate. IP addresses belong in OPS_GATEWAY_IP.
# OPS_GATEWAY_DNS=ops.example.com

# Optional: the host interface and port published for the Ops HTTPS gateway.
# OPS_GATEWAY_BIND_IP=0.0.0.0
# OPS_GATEWAY_PORT=5443

# Optional: the isolated network shared only by Ops and its gateway. Ops trusts exactly this range for forwarded
# client addresses. Change it if it collides with an existing Docker or LAN subnet, then recreate that network.
# OPS_GATEWAY_SUBNET=172.30.0.0/24
