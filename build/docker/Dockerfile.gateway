# The HTTPS reverse proxy for the Ops console. Optional, used by docker-compose.ops.yml.
# Build from the repository root:  docker build -f build/docker/Dockerfile.gateway .
# The SDK global.json pins; see Dockerfile.rendezvous for why this is not the floating 10.0 tag.
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:747cbade5bfd918a175ac32f8f1d931edec2c7d0d5397a3de72eaef1ac1f66d2 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/ src/
RUN --mount=type=cache,id=nuget-rd,target=/root/.nuget/packages,sharing=locked \
    dotnet restore src/Server/RemoteDesktop.Server.Gateway --locked-mode \
    && dotnet publish src/Server/RemoteDesktop.Server.Gateway -c Release --no-self-contained --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:1a48394b6f29d3a32c79d9edecd4abda0ecbe8776d567dbfc4590ed6979c740c AS runtime

# The entrypoint creates the IP SAN self-signed certificate on first start. Installing openssl explicitly keeps that
# independent of what a future base image happens to include.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

ARG VERSION=dev
LABEL org.opencontainers.image.version="$VERSION"
WORKDIR /app
COPY --from=build /app ./
COPY build/docker/gateway-entrypoint.sh /usr/local/bin/gateway-entrypoint.sh

# The named volume inherits this ownership when Docker initializes it. The container runs as the non-root app user,
# which must be able to write the private key once and read it on every later start.
RUN chmod 0755 /usr/local/bin/gateway-entrypoint.sh \
    && mkdir -p /data/gateway/tls \
    && chown -R $APP_UID:$APP_UID /data

EXPOSE 5443/tcp

USER $APP_UID

ENTRYPOINT ["/usr/local/bin/gateway-entrypoint.sh"]
