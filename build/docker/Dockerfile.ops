# The ops console: node health, devices, sessions, alerts and audit. Optional; see docker-compose.ops.yml.
# Build from the repository root:  docker build -f build/docker/Dockerfile.ops .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Core/ src/Core/
COPY src/Server/ src/Server/
RUN --mount=type=cache,id=nuget-rd,target=/root/.nuget/packages,sharing=locked \
    dotnet publish src/Server/RemoteDesktop.Server.Ops -c Release --no-self-contained -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

# See Dockerfile.rendezvous: the console can be pointed at PostgreSQL, and Npgsql probes for GSSAPI at start-up.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

ARG VERSION=dev
LABEL org.opencontainers.image.version="$VERSION"
WORKDIR /app
COPY --from=build /app ./

# /data is where a SQLite deployment keeps ops.db (the shipped compose overlay uses PostgreSQL instead). The
# DataProtection directory is created and owned the same way so a named volume mounted there is writable by the app
# user; without it ASP.NET Core warns that its keys will disappear with the container.
RUN mkdir -p /data /home/app/.aspnet/DataProtection-Keys \
    && chown -R $APP_UID:$APP_UID /data /home/app/.aspnet

# The console listens on all interfaces inside the container so the gateway container can reach it. Compose does not
# publish this port on the host.
EXPOSE 5090/tcp

USER $APP_UID
ENTRYPOINT ["dotnet", "RemoteDesktop.Server.Ops.dll"]
