# The relay: forwards encrypted QUIC datagrams between two peers that cannot reach each other directly.
# Build from the repository root:  docker build -f build/docker/Dockerfile.relay .
# The SDK global.json pins; see Dockerfile.rendezvous for why this is not the floating 10.0 tag.
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:747cbade5bfd918a175ac32f8f1d931edec2c7d0d5397a3de72eaef1ac1f66d2 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Core/ src/Core/
COPY src/Server/ src/Server/
# The cache mount keeps NuGet downloads out of the layer; see Dockerfile.rendezvous. This needs BuildKit (the default
# in Docker 23+).
RUN --mount=type=cache,id=nuget-rd,target=/root/.nuget/packages,sharing=locked \
    dotnet restore src/Server/RemoteDesktop.Server.Relay --locked-mode \
    && dotnet publish src/Server/RemoteDesktop.Server.Relay -c Release --no-self-contained --no-restore -o /app

# The relay is an ASP.NET Core host: /health, /metrics and /internal/v1/info are Kestrel endpoints even though the
# forwarding itself is plain UDP. It therefore needs the ASP.NET shared framework, not just the .NET runtime.
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:1a48394b6f29d3a32c79d9edecd4abda0ecbe8776d567dbfc4590ed6979c740c AS runtime
ARG VERSION=dev
LABEL org.opencontainers.image.version="$VERSION"
WORKDIR /app
COPY --from=build /app ./

EXPOSE 5082/udp
# The loopback-only HTTP face: /health, /metrics and /internal/v1/info. The base compose file does not publish it;
# docker-compose.ops.yml makes it reachable to the console over the compose network.
EXPOSE 5083/tcp

USER $APP_UID
ENTRYPOINT ["dotnet", "RemoteDesktop.Server.Relay.dll"]
