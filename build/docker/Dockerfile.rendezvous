# The signaling server: device codes, presence, hole-punch coordination and relay tickets.
# Build from the repository root:  docker build -f build/docker/Dockerfile.rendezvous .
#
# The SDK image is the exact version global.json pins, not the floating 10.0 tag: that image had already moved on to
# 10.0.403 while global.json asks for 10.0.402 with rollForward disabled, so the restore below stopped at "A compatible
# .NET SDK was not found" on a repository nobody had changed. Move the tag and its digest together with global.json.
FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:747cbade5bfd918a175ac32f8f1d931edec2c7d0d5397a3de72eaef1ac1f66d2 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Core/ src/Core/
COPY src/Server/ src/Server/
# The cache mount keeps NuGet downloads out of the layer: a source change re-runs restore, but against the local
# cache rather than the network. Full project-file splitting would add a second copy of every path for a marginal
# gain; the downloads are the expensive part. This needs BuildKit, which is the default in Docker 23+.
RUN --mount=type=cache,id=nuget-rd,target=/root/.nuget/packages,sharing=locked \
    dotnet restore src/Server/RemoteDesktop.Server.Rendezvous --locked-mode \
    && dotnet publish src/Server/RemoteDesktop.Server.Rendezvous -c Release --no-self-contained --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:1a48394b6f29d3a32c79d9edecd4abda0ecbe8776d567dbfc4590ed6979c740c AS runtime

# Npgsql probes for GSSAPI when it initializes its authentication mechanisms. Without the library the probe prints
# "Cannot load library libgssapi_krb5.so.2" on every start; password authentication still works, but an error line in
# a log an operator is told to read is not acceptable when a small package removes it. It also makes Kerberos-based
# PostgreSQL authentication available to deployments that need it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

# The version in the image's metadata is the one it was built from (docker-compose.yml passes it through). It is
# informational only: the assemblies carry the same number from Directory.Build.props.
ARG VERSION=dev
LABEL org.opencontainers.image.version="$VERSION"
WORKDIR /app
COPY --from=build /app ./

# SQLite deployments point at /data. A fresh named volume mounted there is root-owned unless the image has the
# directory first, and the server runs as the non-root app user. Creating it here gives the volume that ownership
# when Docker initializes it; the PostgreSQL path does not write here and is unaffected.
RUN mkdir -p /data && chown $APP_UID:$APP_UID /data

# Signaling (WebSocket on /ws, health on /health) and the UDP address reflector.
EXPOSE 5080/tcp
EXPOSE 5081/udp

# The container is not root: nothing here needs to be.
USER $APP_UID

# The reflector is a UDP socket inside the container; the published port must be a UDP mapping.
ENTRYPOINT ["dotnet", "RemoteDesktop.Server.Rendezvous.dll"]
