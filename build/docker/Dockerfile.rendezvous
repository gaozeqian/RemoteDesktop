# The signaling server: device codes, presence, hole-punch coordination and relay tickets.
# Build from the repository root:  docker build -f build/docker/Dockerfile.rendezvous .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Core/ src/Core/
COPY src/Server/ src/Server/
# The cache mount keeps NuGet downloads out of the layer: a source change re-runs restore, but against the local
# cache rather than the network. Full project-file splitting would add a second copy of every path for a marginal
# gain; the downloads are the expensive part. This needs BuildKit, which is the default in Docker 23+.
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish src/Server/RemoteDesktop.Server.Rendezvous -c Release --no-self-contained -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
# The version in the image's metadata is the one it was built from (docker-compose.yml passes it through). It is
# informational only: the assemblies carry the same number from Directory.Build.props.
ARG VERSION=dev
LABEL org.opencontainers.image.version="$VERSION"
WORKDIR /app
COPY --from=build /app ./

# SQLite deployments point at /data. A fresh named volume mounted there is root-owned unless the image has the
# directory first, and the server runs as the non-root app user. Creating it here gives the volume that ownership
# when Docker initializes it; the PostgreSQL path does not write here and is unaffected.
RUN mkdir -p /data && chown $APP_UID:$APP_UID /data

# Signaling (WebSocket on /ws, health on /health) and the UDP address reflector.
EXPOSE 5080/tcp
EXPOSE 5081/udp

# The container is not root: nothing here needs to be.
USER $APP_UID

# The reflector is a UDP socket inside the container; the published port must be a UDP mapping.
ENTRYPOINT ["dotnet", "RemoteDesktop.Server.Rendezvous.dll"]
