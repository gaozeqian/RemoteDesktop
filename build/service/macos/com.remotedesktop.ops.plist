<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The monitoring console as a launchd job.

  A LaunchDaemon like the two servers, because it has to be up whether or not anybody is logged in and it is scraped by
  nothing but its own UI. The console binds to loopback by default: it has its own sign-in and no rate limits worth
  trusting on a public socket, so exposing it is a reverse-proxy decision, not a package default.

  The paths are fixed at build time for the same reason as the servers': launchd starts the executable named here, and
  the package writes the payload to match.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.remotedesktop.ops</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/remotedesktop-server/Ops/RemoteDesktop.Server.Ops</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/usr/local/remotedesktop-server/Ops</string>

    <!-- Same account as the two servers; see com.remotedesktop.rendezvous.plist. -->
    <key>UserName</key>
    <string>_remotedesktop</string>
    <key>GroupName</key>
    <string>_remotedesktop</string>

    <!-- Database path and listener stay in Ops/appsettings.json so custom settings also apply to --create-admin.
         HOME is required for ASP.NET Core DataProtection: LaunchDaemon has no home directory by default. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/usr/local/remotedesktop-server/var</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/usr/local/remotedesktop-server/logs/ops.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/remotedesktop-server/logs/ops.log</string>
</dict>
</plist>
