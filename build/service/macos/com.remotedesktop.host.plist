<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The host-only app (Remote Desktop Host.app) as a per-user launch agent.

  Why a LaunchAgent and not a LaunchDaemon: macOS grants screen recording and accessibility only to a signed app
  running inside a user's GUI session. A root daemon cannot capture the screen at all (see docs/ports/README.md,
  "TCC 授权按签名身份记账"). The bundle is LSUIElement, so it has no window; this job is what starts it at login.

  Install path: /Library/LaunchAgents, so the job exists for every account on the machine and runs when that account
  logs into the graphical session. RunAtLoad starts it once per login. KeepAlive restarts it after an abnormal exit
  only: the app has no window and no way to be quit, so a crash (a ScreenCaptureKit error, a portal that went away)
  would otherwise leave an unattended machine unreachable until the next login. A deliberate exit is left alone.

  This is the only auto-start mechanism on macOS. There is no in-app "start at login" toggle in the host bundle: the
  host has no UI at all. The application lives under Library/Application Support rather than /Applications precisely
  because it is not something a person opens; Remote Desktop.app is the window, and it delegates to this service when
  both packages are installed.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.remotedesktop.host</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/RemoteDesktop/Host/Remote Desktop Host.app/Contents/MacOS/RemoteDesktop.HostService</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Only in a graphical login. Without this launchd would also try to start it from an ssh session, where there
         is no screen to share. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
