[Unit]
Description=Remote Desktop Ops Console (monitoring and management)
Documentation=https://github.com/gaozeqian/RemoteDesktop
After=network-online.target remotedesktop-rendezvous.service remotedesktop-relay.service
Wants=network-online.target

[Service]
Type=notify
User=remotedesktop
Group=remotedesktop

# The console binds to loopback by default: it has its own sign-in and no rate limits worth trusting on a public
# socket, so exposing it is a reverse-proxy decision, not a default. The database lives beside the server's own, so
# the one account owns both.
WorkingDirectory=/usr/lib/remotedesktop-server/Ops
ExecStart=/usr/lib/remotedesktop-server/Ops/RemoteDesktop.Server.Ops

Environment=Ops__Database__Path=/var/lib/remotedesktop-server/ops.db
Environment=Ops__Listen=http://127.0.0.1:5090

Restart=always
RestartSec=5
# No start limit: a console being reconfigured should keep coming back.
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
StateDirectory=remotedesktop-server
LogsDirectory=remotedesktop-server

# Nothing outside its own state, configuration and logs is writable; the program itself is read-only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ReadWritePaths=/var/lib/remotedesktop-server /var/log/remotedesktop-server

[Install]
WantedBy=multi-user.target
