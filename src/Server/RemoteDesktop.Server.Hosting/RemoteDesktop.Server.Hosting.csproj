<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The startup path the four server hosts share: configuration layering, the Windows service / systemd registration,
    and the node-token endpoint filter. It is deliberately not Server.Shared: Ops.Core references that project and must
    stay free of ASP.NET, which a project carrying the web host and the service packages would leak into it.

    A class library with the ASP.NET Core framework reference, not Microsoft.NET.Sdk.Web: the web SDK treats every
    JSON file as publish content, and this project's per-RID NuGet lock files then collide with the host's identical
    names at publish time.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\RemoteDesktop.Server.Shared\RemoteDesktop.Server.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>
</Project>
