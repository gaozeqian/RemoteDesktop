<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The console's web host: endpoints, authentication, static files, background tasks. It owns no policy — the parser,
    the projections and the rule engine live in Server.Ops.Core — and no SQL, which lives in Server.Ops.Storage. Both
    boundaries are enforced by tests/RemoteDesktop.Architecture.UnitTests, not by good intentions.
  -->
  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Server.Ops.Core\RemoteDesktop.Server.Ops.Core.csproj" />
    <ProjectReference Include="..\RemoteDesktop.Server.Ops.Storage\RemoteDesktop.Server.Ops.Storage.csproj" />
    <!-- Metric names and the node-info contract. Shared is where the emitting servers and the console agree on them. -->
    <ProjectReference Include="..\RemoteDesktop.Server.Shared\RemoteDesktop.Server.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemoteDesktop.Server.Ops.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- dotnet build does not copy static assets into the output; only publish does. Running the built dll — which is
         what an unpacked build and the smoke test do — would then serve 404 for the shell while every API works, the
         least obvious way for it to be broken. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
