<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\RemoteDesktop.Server.Hosting\RemoteDesktop.Server.Hosting.csproj" />
    <ProjectReference Include="..\RemoteDesktop.Server.Shared\RemoteDesktop.Server.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The development file carries a fixed relay key that is public in the repository. It is still used by
         `dotnet run`, but a published server (the packages and the container images) runs in Production and has no
         reason to carry a known secret. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
