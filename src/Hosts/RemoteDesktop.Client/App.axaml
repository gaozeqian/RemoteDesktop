<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="RemoteDesktop.Client.App"
             Name="Remote Desktop"
             RequestedThemeVariant="Default">
  <!-- Name is what macOS puts in the global menu bar (the bold item next to the Apple logo). Avalonia falls back to
       "Avalonia Application" when it is unset, which is what shipped before this line existed. It is not the window
       title — that is set per window — and on Windows it has no visible effect. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RemoteDesktop.Client/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://RemoteDesktop.Client/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!--
      The palette is how Fluent's own controls (check box, text-box focus, progress bar, tab underline) are
      told which accent to use. Left to the platform they follow the desktop accent — orange on Ubuntu — while
      this app's buttons, radio rings and navigation are the blue in Tokens.axaml. Setting `Accent` here makes
      both halves one colour; its shade/tint steps are derived automatically.
    -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <fluent:ColorPaletteResources x:Key="Light" Accent="#3B82F6" />
        <fluent:ColorPaletteResources x:Key="Dark" Accent="#3B82F6" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- After FluentTheme on purpose: styles declared later win against the theme for the same property. -->
    <StyleInclude Source="avares://RemoteDesktop.Client/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
