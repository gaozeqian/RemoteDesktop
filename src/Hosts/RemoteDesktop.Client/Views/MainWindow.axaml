<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteDesktop.Client.ViewModels"
        x:Class="RemoteDesktop.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RemoteDesktop"
        Width="760" Height="440" MinWidth="640" MinHeight="400">
  <Grid ColumnDefinitions="*,*" RowDefinitions="*,Auto" Margin="24">
    <!-- This device -->
    <Border Grid.Column="0" Margin="0,0,12,0" Padding="20" CornerRadius="8"
            Background="{StaticResource CardBackgroundBrush}">
      <StackPanel Spacing="12">
        <TextBlock Text="允许控制本设备" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="设备代码" Opacity="0.7" />
        <SelectableTextBlock Text="{Binding LocalDeviceId}" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="临时密码" Opacity="0.7" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <SelectableTextBlock Text="{Binding TemporaryPassword}" FontSize="20" VerticalAlignment="Center" />
          <Button Content="刷新" Command="{Binding RefreshPasswordCommand}" />
        </StackPanel>
        <CheckBox IsChecked="{Binding AllowCamera, Mode=TwoWay}" Content="允许控制端使用本机摄像头" />
        <TextBlock Text="{Binding HostDetail}" IsVisible="{Binding HostDetail, Converter={x:Static ObjectConverters.IsNotNull}}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
        <!-- No device code means no server: say so where the code would be, instead of leaving an empty field. -->
        <TextBlock Text="{Binding ServerHint}" IsVisible="{Binding ServerHint, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="OrangeRed" FontSize="12" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding IncomingSessions}" IsVisible="{Binding HasIncoming}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HostSessionItem">
              <StackPanel Spacing="6" Margin="0,4,0,0">
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SystemAccentColor}" TextWrapping="Wrap" />
                <TextBlock Text="正在使用本机摄像头" IsVisible="{Binding CameraActive}" Foreground="OrangeRed" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="关闭摄像头" Command="{Binding StopCameraCommand}" IsVisible="{Binding CameraActive}" />
                  <Button Content="仅观看" Command="{Binding DowngradeCommand}" IsVisible="{Binding CanDowngrade}" />
                  <Button Content="断开" Command="{Binding DisconnectCommand}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Remote device -->
    <Border Grid.Column="1" Margin="12,0,0,0" Padding="20" CornerRadius="8"
            Background="{StaticResource CardBackgroundBrush}">
      <StackPanel Spacing="12">
        <TextBlock Text="远程控制设备" FontSize="18" FontWeight="SemiBold" />
        <TextBox Text="{Binding RemoteDeviceId}" PlaceholderText="伙伴设备代码" />
        <TextBox Text="{Binding RemotePassword}" PlaceholderText="密码" PasswordChar="●" />
        <CheckBox IsChecked="{Binding IsWatchMode}" Content="观看模式（只看不控）" />
        <Button Content="连接" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Classes="accent"
                IsVisible="{Binding !IsConnected}" />
        <Button Content="断开" Command="{Binding DisconnectCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsVisible="{Binding IsConnected}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="{Binding ServerStatus}" Opacity="0.6" Margin="16,0,0,0" />
    </Grid>
  </Grid>
</Window>
