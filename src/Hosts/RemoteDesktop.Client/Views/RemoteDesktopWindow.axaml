<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteDesktop.Client.ViewModels"
        x:Class="RemoteDesktop.Client.Views.RemoteDesktopWindow"
        x:DataType="vm:RemoteDesktopViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icon-256.png"
        Width="1280" Height="760" Background="{DynamicResource RdVideoBackdropBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <!--
          A DockPanel rather than a horizontal StackPanel: a horizontal StackPanel measures its children with
          infinite width, so neither TextBlock ever trims. The recording message (a full path plus frame count)
          then ran underneath the buttons, which is exactly what happened the first time a recording was saved.
          Docking it right with a ceiling leaves the stream status the rest of the row; both trim.
        -->
        <DockPanel LastChildFill="True" VerticalAlignment="Center">
          <TextBlock DockPanel.Dock="Right" Text="{Binding RecordingStatusMessage}" Foreground="{DynamicResource RdWarningBrush}"
                     FontSize="{DynamicResource RdFontCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     MaxWidth="520" Margin="12,0,0,0" ToolTip.Tip="{Binding RecordingStatusMessage}"
                     IsVisible="{Binding RecordingStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding StatusText}" Classes="secondary" FontSize="{DynamicResource RdFontCaption}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource RdSpaceSm}" Margin="12,0,0,0">
          <!-- Display and sound -->
          <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" IsVisible="{Binding ShowDisplayPicker}"
                    MinWidth="200" FontSize="{DynamicResource RdFontCaption}" VerticalAlignment="Center"
                    AutomationProperties.Name="显示器">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DisplayChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleButton Content="静音" IsChecked="{Binding IsMuted, Mode=OneWay}" Command="{Binding ToggleMuteCommand}"
                        IsVisible="{Binding HasAudio}" VerticalAlignment="Center" />

          <Border Classes="toolbarSeparator" />

          <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" VerticalAlignment="Center" />

          <Border Classes="toolbarSeparator" />

          <!-- The session's own features; each is hidden when the host did not grant it. -->
          <Button Content="文件" Command="{Binding OpenFilesCommand}" IsVisible="{Binding CanTransferFiles}" VerticalAlignment="Center" />
          <Button Content="终端" Command="{Binding OpenTerminalCommand}" IsVisible="{Binding CanUseTerminal}" VerticalAlignment="Center" />
          <Button Content="摄像头" Command="{Binding OpenCameraCommand}" IsVisible="{Binding CanUseCamera}" VerticalAlignment="Center" />
          <!-- Only a host that can raise Ctrl+Alt+Del grants the permission, so the button follows the host rather than
               the controller's platform: it is absent for a macOS host and for a Windows client hosting by itself. -->
          <Button Content="Ctrl+Alt+Del" Command="{Binding SendSecureAttentionCommand}" IsVisible="{Binding CanSendSecureAttention}" VerticalAlignment="Center" />

          <Border Classes="toolbarSeparator" />

          <Button Content="断开" Command="{Binding DisconnectCommand}" Classes="danger" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The controlled end's desktop can refuse synthetic input even though the session's grant allows control; this
         says so instead of leaving the user typing into nothing, and offers the one action that can change it. -->
    <Border DockPanel.Dock="Top" Classes="banner warning" Margin="12,8,12,0"
            IsVisible="{Binding InputAccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource RdSpaceMd}">
        <TextBlock Text="{Binding InputAccessMessage}" Classes="warning" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="重试授权" Command="{Binding RetryInputAccessCommand}"
                IsVisible="{Binding CanRetryInputAccess}" IsEnabled="{Binding !IsInputAccessRequesting}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- The screen is focusable so keyboard input goes to the remote desktop instead of moving focus around the window.
         The host's real pointer is drawn on the overlay above it. Screen and Overlay must stay siblings in this same
         Grid cell with identical bounds: the letterbox maths reads Screen.Bounds and positions the cursor on Overlay. -->
    <Grid x:Name="InputGrid" Background="Transparent">
      <Image x:Name="Screen" Stretch="Uniform" Focusable="True" />
      <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True">
        <Image x:Name="RemoteCursor" IsVisible="False" IsHitTestVisible="False" />
      </Canvas>
    </Grid>
  </DockPanel>
</Window>
