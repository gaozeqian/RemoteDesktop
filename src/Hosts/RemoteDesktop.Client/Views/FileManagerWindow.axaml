<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteDesktop.Client.ViewModels"
        xmlns:v="using:RemoteDesktop.Client.Views"
        x:Class="RemoteDesktop.Client.Views.FileManagerWindow"
        x:DataType="vm:FileManagerViewModel"
        Title="文件传输"
        Icon="/Assets/icon-256.png"
        Background="{DynamicResource RdWindowBackgroundBrush}"
        Width="1100" Height="720" MinWidth="760" MinHeight="480">
  <Grid RowDefinitions="*,Auto,Auto,180" Margin="12" RowSpacing="{DynamicResource RdSpaceMd}">
    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="{DynamicResource RdSpaceMd}">
      <v:FilePaneView DataContext="{Binding LocalPane}" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource RdSpaceSm}">
        <Button Content="上传 →" Command="{Binding UploadCommand}" HorizontalAlignment="Stretch" Classes="feature" />
        <Button Content="← 下载" Command="{Binding DownloadCommand}" HorizontalAlignment="Stretch" Classes="feature" />
      </StackPanel>
      <!-- Files can be dropped from the Windows Explorer onto this side. -->
      <v:FilePaneView x:Name="RemotePaneView" Grid.Column="2" DataContext="{Binding RemotePane}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource RdSpaceSm}">
      <TextBlock Text="文件已存在时：" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" MinWidth="180">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConflictChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="danger" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="3" Content="清除已完成" Command="{Binding ClearFinishedCommand}" />
    </Grid>

    <TextBlock Grid.Row="2" Text="传输列表" Classes="sectionHeader" />
    <TextBlock Grid.Row="3" Text="暂无传输" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding !HasTransfers}" />
    <ListBox Grid.Row="3" ItemsSource="{Binding Transfers}" SelectionMode="Single" IsVisible="{Binding HasTransfers}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TransferItemViewModel">
          <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="{DynamicResource RdSpaceMd}">
            <StackPanel>
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Status}" Classes="caption" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" />
              <TextBlock Text="{Binding Detail}" Classes="caption" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource RdSpaceXs}" VerticalAlignment="Center">
              <Button Content="暂停" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" Classes="feature" />
              <Button Content="{Binding ResumeLabel}" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" Classes="feature" />
              <Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Classes="feature" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
