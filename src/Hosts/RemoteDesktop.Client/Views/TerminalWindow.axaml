<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteDesktop.Client.ViewModels"
        xmlns:v="using:RemoteDesktop.Client.Views"
        x:Class="RemoteDesktop.Client.Views.TerminalWindow"
        x:DataType="vm:TerminalWindowViewModel"
        Title="远程终端"
        Icon="/Assets/icon-256.png"
        Background="{DynamicResource RdWindowBackgroundBrush}"
        Width="1000" Height="640" MinWidth="480" MinHeight="300">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource RdSpaceSm}">
        <TextBlock Text="Shell" Classes="secondary" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Shells}" SelectedItem="{Binding SelectedShell}" MinWidth="140"
                  VerticalAlignment="Center" />
        <Button Content="新建标签" Command="{Binding NewTabCommand}" VerticalAlignment="Center" />
        <Border Classes="toolbarSeparator" />
        <TextBlock Text="{Binding Message}" Classes="danger" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TerminalTabViewModel">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource RdSpaceSm}">
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            <Button Content="✕" Command="{Binding CloseCommand}" Classes="iconButton" MinHeight="0" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:TerminalTabViewModel">
          <v:TerminalTabView />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
