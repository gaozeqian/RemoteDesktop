<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemoteDesktop.Client.ViewModels"
        x:Class="RemoteDesktop.Client.Views.CameraWindow"
        x:DataType="vm:CameraWindowViewModel"
        Title="远程摄像头"
        Icon="/Assets/icon.ico"
        Width="960" Height="640" MinWidth="520" MinHeight="380" Background="Black">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#E0202020" Padding="12,8">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" MinWidth="220" IsEnabled="{Binding !IsStreaming}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CameraChoice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" MinWidth="170" IsEnabled="{Binding !IsStreaming}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CameraModeChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="开始" Command="{Binding StartCommand}" Classes="accent" />
          <Button Content="停止" Command="{Binding StopCommand}" />
          <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" IsVisible="{Binding IsStreaming}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding StatusText}" Foreground="#DDFFFFFF" FontSize="12" IsVisible="{Binding IsStreaming}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding RecordingStatusMessage}" Foreground="#FFCC00" FontSize="12" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding RecordingStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <TextBlock Text="{Binding Message}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
    <Image x:Name="Picture" Stretch="Uniform" />
  </DockPanel>
</Window>
