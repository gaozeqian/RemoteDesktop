<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RemoteDesktop.Client.Controls"
             xmlns:vm="using:RemoteDesktop.Client.ViewModels"
             x:Class="RemoteDesktop.Client.Views.TerminalTabView"
             x:DataType="vm:TerminalTabViewModel">
  <!-- The terminal keeps its own colours in both themes: RdTerminalBackgroundBrush is the palette's default
       background, so the surface behind the canvas cannot show a seam around it. -->
  <Grid RowDefinitions="*,Auto" Background="{DynamicResource RdTerminalBackgroundBrush}">
    <c:TerminalControl x:Name="Terminal" Margin="6,4,0,0" />
    <Border Grid.Row="1" Background="{DynamicResource RdTerminalStatusBrush}" Padding="10,5"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource RdTerminalStatusTextBrush}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
