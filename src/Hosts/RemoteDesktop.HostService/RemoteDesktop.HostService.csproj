<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RemoteDesktop.HostService</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\RemoteDesktop.Application\RemoteDesktop.Application.csproj" />
    <ProjectReference Include="..\..\Platform\RemoteDesktop.Platform.Windows\RemoteDesktop.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\Platform\RemoteDesktop.Platform.Linux\RemoteDesktop.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\Media\RemoteDesktop.Media\RemoteDesktop.Media.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.Desktop\RemoteDesktop.Features.Desktop.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.FileTransfer\RemoteDesktop.Features.FileTransfer.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.Terminal\RemoteDesktop.Features.Terminal.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.Camera\RemoteDesktop.Features.Camera.csproj" />
    <!-- Built before the service so the agent executable can be copied next to it; nothing is referenced from it.
         Windows only: elsewhere there is no agent to build, and copying one into the output would put a Windows
         executable in a Linux package. -->
    <ProjectReference Include="..\RemoteDesktop.SessionAgent\RemoteDesktop.SessionAgent.csproj" ReferenceOutputAssembly="false" Private="false" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <!-- The service starts the agent from its own folder (see AgentGatewayOptions.ExecutablePath), so a plain build puts
       the agent's build output next to it. Publishing is a separate matter: the installer publishes each executable
       self-contained into one folder (see build/installer/windows/client/Build-ClientInstaller.ps1), because a framework-dependent
       agent copied into a self-contained folder would look for the .NET runtime on the target machine. -->
  <Target Name="CopySessionAgent" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Ask the agent's project where its output is instead of spelling out bin\<Configuration>\<TFM>\. A hand-written
         path silently stops matching the moment the output layout moves — which is what happened when the repository
         adopted UseArtifactsOutput: these globs matched nothing, MSBuild does not error on an empty item list, and the
         copy quietly did nothing. GetTargetPath cannot drift from the layout; it does not build (the ProjectReference
         above already orders it). -->
    <MSBuild Projects="..\RemoteDesktop.SessionAgent\RemoteDesktop.SessionAgent.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_AgentTargetPath" />
    </MSBuild>
    <ItemGroup>
      <AgentFiles Include="%(_AgentTargetPath.RootDir)%(_AgentTargetPath.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentFiles)" DestinationFiles="@(AgentFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
