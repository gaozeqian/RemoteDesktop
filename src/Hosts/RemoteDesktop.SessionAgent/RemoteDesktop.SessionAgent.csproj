<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No console window: the agent runs invisibly in the interactive session. -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Which manifest the executable carries. UIAccess (app.uiaccess.manifest) lets the agent drive elevated windows,
         but Windows only starts such an image when it is signed with a certificate the machine trusts *and* sits in a
         secure location - an unsigned build, or one running out of bin\Debug, is refused outright ("a referral was
         returned from the server", or error 740). So only the packaged build the installer puts into Program Files
         asks for it: build-installer.ps1 publishes with -p:UiAccessAgent=true.
         Without it the agent still captures the screen, injects input and does everything else; it just cannot reach
         windows that run at a higher integrity level. -->
    <ApplicationManifest Condition="'$(UiAccessAgent)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(ApplicationManifest)' == ''">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\RemoteDesktop.Application\RemoteDesktop.Application.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.Desktop\RemoteDesktop.Features.Desktop.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.FileTransfer\RemoteDesktop.Features.FileTransfer.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.Terminal\RemoteDesktop.Features.Terminal.csproj" />
    <ProjectReference Include="..\..\Features\RemoteDesktop.Features.Camera\RemoteDesktop.Features.Camera.csproj" />
    <ProjectReference Include="..\..\Media\RemoteDesktop.Media\RemoteDesktop.Media.csproj" />
    <ProjectReference Include="..\..\Platform\RemoteDesktop.Platform.Windows\RemoteDesktop.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
