<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Stays net10.0 (not -windows) so cross-platform hosts can reference it; every entry point is guarded by
         [SupportedOSPlatform("windows")] and the CA1416 analyzer forces callers to check the OS. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\RemoteDesktop.Abstractions\RemoteDesktop.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="Vortice.MediaFoundation" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemoteDesktop.Platform.Windows.Tests" />
  </ItemGroup>
</Project>
