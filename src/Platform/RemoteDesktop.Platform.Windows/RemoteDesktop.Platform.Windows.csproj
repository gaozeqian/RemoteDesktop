<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Stays net10.0 (not -windows) so cross-platform hosts can reference it; every entry point is guarded by
         [SupportedOSPlatform("windows")] and the CA1416 analyzer forces callers to check the OS. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\RemoteDesktop.Abstractions\RemoteDesktop.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\RemoteDesktop.Domain\RemoteDesktop.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="Vortice.MediaFoundation" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemoteDesktop.Platform.Windows.UnitTests" />
    <!-- The session agent wraps SendInputInjector to route Ctrl+Alt+Del through the service. -->
    <InternalsVisibleTo Include="RemoteDesktop.SessionAgent" />
    <!-- Desktop/camera/agent tests compose the Media Foundation codecs directly. -->
    <InternalsVisibleTo Include="RemoteDesktop.Transport.IntegrationTests" />
  </ItemGroup>
</Project>
