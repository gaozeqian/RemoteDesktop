<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net10.0 and no platform packages: this is the code the three platform assemblies share. It may only
         reference Abstractions/Domain — DependencyRuleTests applies the Platform rules to every assembly whose name
         starts with RemoteDesktop.Platform, including this one. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\RemoteDesktop.Abstractions\RemoteDesktop.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemoteDesktop.Platform.Windows" />
    <InternalsVisibleTo Include="RemoteDesktop.Platform.MacOS" />
    <InternalsVisibleTo Include="RemoteDesktop.Platform.Linux" />
    <InternalsVisibleTo Include="RemoteDesktop.Core.UnitTests" />
  </ItemGroup>
</Project>
