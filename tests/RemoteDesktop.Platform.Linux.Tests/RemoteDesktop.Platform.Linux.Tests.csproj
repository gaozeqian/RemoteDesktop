<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every test checks OperatingSystem.IsLinux() and skips elsewhere. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- The audio test loads a module through a C callback, which needs a function pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Platform\RemoteDesktop.Platform.Linux\RemoteDesktop.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\Core\RemoteDesktop.Application\RemoteDesktop.Application.csproj" />
    <ProjectReference Include="..\..\src\Media\RemoteDesktop.Media\RemoteDesktop.Media.csproj" />
    <!-- For the end-to-end session test, which composes a real host and a real controller against a real rendezvous
         server on loopback. Test projects are not loaded by the architecture rules — those read the assemblies next
         to the architecture tests — so referencing the server from here does not put "Platform depends on Server"
         anywhere it would be checked, or meant. -->
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Rendezvous\RemoteDesktop.Server.Rendezvous.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.Desktop\RemoteDesktop.Features.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.FileTransfer\RemoteDesktop.Features.FileTransfer.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.Terminal\RemoteDesktop.Features.Terminal.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.Camera\RemoteDesktop.Features.Camera.csproj" />
  </ItemGroup>
</Project>
