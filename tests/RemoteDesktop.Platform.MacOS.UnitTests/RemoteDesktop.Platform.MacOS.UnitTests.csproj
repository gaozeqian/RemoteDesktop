<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every test checks OperatingSystem.IsMacOS() and skips elsewhere, exactly like the Windows test project. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- The interop probes call the same pointer-based P/Invoke signatures the platform project exposes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Platform\RemoteDesktop.Platform.MacOS\RemoteDesktop.Platform.MacOS.csproj" />
    <ProjectReference Include="..\..\src\Media\RemoteDesktop.Media\RemoteDesktop.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Building a provider, rather than only inspecting the registrations, is what lets the test fail when a port is
         registered with an implementation that cannot actually be constructed. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- AddLogging, so the composition-root test can build the ports that take an ILogger<T>: the platform project
         itself only references Logging.Abstractions, which carries the interfaces and no provider. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
