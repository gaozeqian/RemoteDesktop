    <ProjectReference Include="..\..\src\Media\RemoteDesktop.Media\RemoteDesktop.Media.csproj" />
    <!-- Every platform project has to be referenced here or the layer rules never see it: the tests load assemblies
         by name prefix out of this project's own output folder, so an unreferenced platform would simply be absent
         and the suite would stay green while checking nothing about it. -->
    <ProjectReference Include="..\..\src\Platform\RemoteDesktop.Platform.Windows\RemoteDesktop.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\Platform\RemoteDesktop.Platform.MacOS\RemoteDesktop.Platform.MacOS.csproj" />
    <ProjectReference Include="..\..\src\Platform\RemoteDesktop.Platform.Posix\RemoteDesktop.Platform.Posix.csproj" />
    <ProjectReference Include="..\..\src\Platform\RemoteDesktop.Platform.Shared\RemoteDesktop.Platform.Shared.csproj" />
    <ProjectReference Include="..\..\src\Platform\RemoteDesktop.Platform.Linux\RemoteDesktop.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.Desktop\RemoteDesktop.Features.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.FileTransfer\RemoteDesktop.Features.FileTransfer.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.Terminal\RemoteDesktop.Features.Terminal.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.Camera\RemoteDesktop.Features.Camera.csproj" />
    <ProjectReference Include="..\..\src\Features\RemoteDesktop.Features.Shared\RemoteDesktop.Features.Shared.csproj" />
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Shared\RemoteDesktop.Server.Shared.csproj" />
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Rendezvous\RemoteDesktop.Server.Rendezvous.csproj" />
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Relay\RemoteDesktop.Server.Relay.csproj" />
    <!-- Without these references the new assemblies never reach this project's output, LoadAssemblies finds nothing
         to check, and the two ops rules below pass by not running. -->
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Ops.Core\RemoteDesktop.Server.Ops.Core.csproj" />
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Ops.Storage\RemoteDesktop.Server.Ops.Storage.csproj" />
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Ops\RemoteDesktop.Server.Ops.csproj" />
    <ProjectReference Include="..\..\src\Server\RemoteDesktop.Server.Gateway\RemoteDesktop.Server.Gateway.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>
</Project>
